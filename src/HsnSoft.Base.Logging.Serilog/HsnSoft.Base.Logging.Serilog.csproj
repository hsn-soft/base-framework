<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <AssemblyName>HsnSoft.Base.Logging.Serilog</AssemblyName>
        <PackageId>HsnSoft.Base.Logging.Serilog</PackageId>
        <RootNamespace />
        <Title>HsnSoft Base Framework Serilog Logging</Title>
        <Description>Serilog as the logging provider of an HsnSoft service: console and persistent sinks (Graylog or file) with the rule that Debug and Verbose logs stay in the console, masking of sensitive data, self-healing Graylog sink.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>HsnSoft Base Framework Logging Serilog Graylog</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftAspNetCorePackageVersion)" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Serilog.Sinks.Graylog" Version="3.1.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HsnSoft.Base.Hosting\HsnSoft.Base.Hosting.csproj" />
        <ProjectReference Include="..\HsnSoft.Base.Logging\HsnSoft.Base.Logging.csproj" />
    </ItemGroup>

</Project>
