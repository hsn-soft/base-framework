<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <AssemblyName>HsnSoft.Base.BlobStoring.Minio</AssemblyName>
        <PackageId>HsnSoft.Base.BlobStoring.Minio</PackageId>
        <RootNamespace />
        <Title>HsnSoft Base Framework Blob Storing MinIO</Title>
        <Description>MinIO (S3 compatible) implementation of the HsnSoft blob store.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>HsnSoft Base Framework BlobStoring Minio S3</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(MicrosoftAspNetCorePackageVersion)" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(MicrosoftAspNetCorePackageVersion)" />
        <PackageReference Include="Minio" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HsnSoft.Base.BlobStoring\HsnSoft.Base.BlobStoring.csproj" />
        <ProjectReference Include="..\HsnSoft.Base.Core\HsnSoft.Base.Core.csproj" />
    </ItemGroup>

</Project>
