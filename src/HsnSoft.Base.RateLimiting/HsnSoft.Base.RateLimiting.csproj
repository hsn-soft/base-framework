<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <AssemblyName>HsnSoft.Base.RateLimiting</AssemblyName>
        <PackageId>HsnSoft.Base.RateLimiting</PackageId>
        <RootNamespace />
        <Title>HsnSoft Base Framework RateLimiting</Title>
        <Description>A limit on how many requests one caller may make in a window of time, across every instance of a service: a named counter per caller, and the in-memory implementation for one process.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>HsnSoft Base Framework RateLimiting RateLimit Throttle</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HsnSoft.Base.Core\HsnSoft.Base.Core.csproj" />
    </ItemGroup>

</Project>
