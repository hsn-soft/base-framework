<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <AssemblyName>HsnSoft.Base.AspNetCore.WebApi</AssemblyName>
        <PackageId>HsnSoft.Base.AspNetCore.WebApi</PackageId>
        <RootNamespace />
        <Title>HsnSoft Base Framework ASP.NET Core WebApi</Title>
        <Description>Web api defaults: problem-details error responses, the global exception handler, enum-as-string JSON and the unified response envelope.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>HsnSoft Base Framework AspNetCore WebApi</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HsnSoft.Base.Core\HsnSoft.Base.Core.csproj" />
    </ItemGroup>

</Project>
