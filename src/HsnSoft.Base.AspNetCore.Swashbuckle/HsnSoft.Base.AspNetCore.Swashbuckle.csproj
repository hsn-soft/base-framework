<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <AssemblyName>HsnSoft.Base.AspNetCore.Swashbuckle</AssemblyName>
        <PackageId>HsnSoft.Base.AspNetCore.Swashbuckle</PackageId>
        <RootNamespace />
        <Title>HsnSoft Base Framework ASP.NET Core Swashbuckle</Title>
        <Description>Swagger (Swashbuckle) for HsnSoft web apis: the document and the UI in one call each, an optional Bearer or OAuth2 authorization, off in production-like environments.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>HsnSoft Base Framework AspNetCore Swagger Swashbuckle OpenAPI</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HsnSoft.Base.AspNetCore\HsnSoft.Base.AspNetCore.csproj" />
    </ItemGroup>

</Project>
