<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <AssemblyName>HsnSoft.Base.BlobStoring.FileSystem</AssemblyName>
        <PackageId>HsnSoft.Base.BlobStoring.FileSystem</PackageId>
        <RootNamespace />
        <Title>HsnSoft Base Framework Blob Storing File System</Title>
        <Description>Local disk implementation of the HsnSoft blob store, for development and single-node deployments: a root folder, a folder for each container, writes that are atomic and names that cannot leave the root.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>HsnSoft Base Framework BlobStoring FileSystem</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HsnSoft.Base.BlobStoring\HsnSoft.Base.BlobStoring.csproj" />
    </ItemGroup>

</Project>
