<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <AssemblyName>HsnSoft.Base.Authorization</AssemblyName>
        <PackageId>HsnSoft.Base.Authorization</PackageId>
        <RootNamespace />
        <Title>HsnSoft Base Framework Authorization</Title>
        <Description>Permission based authorization: the [PermissionAuthorize] attribute, the checker that asks what the user and the roles of the user were granted (in a distributed cache a service fills), and the values a role may be limited by.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>HsnSoft Base Framework Authorization Permissions</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HsnSoft.Base.Core\HsnSoft.Base.Core.csproj" />
    </ItemGroup>

</Project>
