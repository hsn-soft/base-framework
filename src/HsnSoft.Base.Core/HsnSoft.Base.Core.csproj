<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <AssemblyName>HsnSoft.Base.Core</AssemblyName>
        <PackageId>HsnSoft.Base.Core</PackageId>
        <RootNamespace />
        <Description>Core building blocks of the HsnSoft Base Framework: the shared abstractions used across HsnSoft microservices.</Description>
        <Title>HsnSoft Base Framework Core</Title>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>HsnSoft Base Framework Core</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftAspNetCorePackageVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftAspNetCorePackageVersion)" />
    </ItemGroup>

    <!--
        Installs the Git hooks (Husky.Net) the first time a developer restores the solution: formatting is fixed and checked
        before every commit. Skipped in CI, outside a Git checkout, and when HUSKY=0.
    -->
    <Target Name="InstallGitHooks" BeforeTargets="Restore;CollectPackageReferences" Condition="'$(HUSKY)' != '0' And '$(GITHUB_ACTIONS)' != 'true' And '$(IsCrossTargetingBuild)' != 'true' And Exists('$(MSBuildThisFileDirectory)..\..\.git')">
        <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildThisFileDirectory)..\.." StandardOutputImportance="Low" StandardErrorImportance="Low" IgnoreExitCode="true" />
        <Exec Command="dotnet husky install" WorkingDirectory="$(MSBuildThisFileDirectory)..\.." StandardOutputImportance="Low" StandardErrorImportance="Low" IgnoreExitCode="true" />
    </Target>

</Project>
