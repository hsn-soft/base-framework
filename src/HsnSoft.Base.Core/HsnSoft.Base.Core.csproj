<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>HsnSoft.Base.Core</AssemblyName>
        <PackageId>HsnSoft.Base.Core</PackageId>
        <RootNamespace />
        <Title>HsnSoft Base Framework Core</Title>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>HsnSoft Base Framework Core</PackageTags>
