<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <AssemblyName>HsnSoft.Base.Concurrency.StackExchangeRedis</AssemblyName>
        <PackageId>HsnSoft.Base.Concurrency.StackExchangeRedis</PackageId>
        <RootNamespace />
        <Title>HsnSoft Base Framework Concurrency StackExchangeRedis</Title>
        <Description>Redis implementation of the HsnSoft concurrency limiter: one atomic script, leases that end by themselves, and the clock of Redis, so the limit holds across every pod.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>HsnSoft Base Framework Concurrency Redis Semaphore</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="StackExchange.Redis" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HsnSoft.Base.Concurrency\HsnSoft.Base.Concurrency.csproj" />
    </ItemGroup>

</Project>
