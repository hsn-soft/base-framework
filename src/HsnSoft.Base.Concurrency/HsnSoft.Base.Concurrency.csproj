<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <AssemblyName>HsnSoft.Base.Concurrency</AssemblyName>
        <PackageId>HsnSoft.Base.Concurrency</PackageId>
        <RootNamespace />
        <Title>HsnSoft Base Framework Concurrency</Title>
        <Description>A limit on how many times something runs at the same time, across every instance of a service: a named semaphore with leases that end by themselves, and the in-memory implementation for one process.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>HsnSoft Base Framework Concurrency Semaphore Limit</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HsnSoft.Base.Core\HsnSoft.Base.Core.csproj" />
    </ItemGroup>

</Project>
