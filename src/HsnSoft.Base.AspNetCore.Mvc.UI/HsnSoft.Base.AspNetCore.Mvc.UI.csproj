    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NUglify" Version="1.21.17" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HsnSoft.Base.AspNetCore.Mvc\HsnSoft.Base.AspNetCore.Mvc.csproj" />
        <ProjectReference Include="..\HsnSoft.Base.UI.Navigation\HsnSoft.Base.UI.Navigation.csproj" />
    </ItemGroup>

</Project>
