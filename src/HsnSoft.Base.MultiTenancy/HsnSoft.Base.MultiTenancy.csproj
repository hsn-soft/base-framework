<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <AssemblyName>HsnSoft.Base.MultiTenancy</AssemblyName>
        <PackageId>HsnSoft.Base.MultiTenancy</PackageId>
        <RootNamespace />
        <Title>HsnSoft Base Framework MultiTenancy</Title>
        <Description>Tenants for an HsnSoft service that wants them: the entity of a tenant (IMultiTenant), the tenant of the request (ICurrentTenant) and where it comes from. A service without tenants does not reference it.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>HsnSoft Base Framework MultiTenancy Tenant</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftAspNetCorePackageVersion)" />
    </ItemGroup>

</Project>
