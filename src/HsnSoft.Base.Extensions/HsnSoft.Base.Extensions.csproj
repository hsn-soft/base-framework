<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <AssemblyName>HsnSoft.Base.Extensions</AssemblyName>
        <PackageId>HsnSoft.Base.Extensions</PackageId>
        <RootNamespace />
        <Title>HsnSoft Base Framework Extensions</Title>
        <Description>Small helpers that the .NET base library does not have, with no package of anyone else's: Base64 text (standard and URL-safe) and a few collection extensions.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>HsnSoft Base Framework Extensions Base64 Collections</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HsnSoft.Base.Core\HsnSoft.Base.Core.csproj" />
    </ItemGroup>

</Project>
