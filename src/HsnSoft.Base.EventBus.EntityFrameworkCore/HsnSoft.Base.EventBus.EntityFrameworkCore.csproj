<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <AssemblyName>HsnSoft.Base.EventBus.EntityFrameworkCore</AssemblyName>
        <PackageId>HsnSoft.Base.EventBus.EntityFrameworkCore</PackageId>
        <RootNamespace />
        <Title>HsnSoft Base Framework Event Inbox on EF Core</Title>
        <Description>The inbox of a service on EF Core: a message that comes twice is handled once. Opt in per service with AddEventInbox, on the context of the service.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>HsnSoft Base Framework EventBus Inbox EntityFrameworkCore</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(MicrosoftAspNetCorePackageVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HsnSoft.Base.EntityFrameworkCore\HsnSoft.Base.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\HsnSoft.Base.EventBus\HsnSoft.Base.EventBus.csproj" />
        <ProjectReference Include="..\HsnSoft.Base.Hosting\HsnSoft.Base.Hosting.csproj" />
    </ItemGroup>

</Project>
