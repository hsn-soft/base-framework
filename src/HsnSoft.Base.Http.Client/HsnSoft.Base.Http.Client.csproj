<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <AssemblyName>HsnSoft.Base.Http.Client</AssemblyName>
        <PackageId>HsnSoft.Base.Http.Client</PackageId>
        <RootNamespace />
        <Title>HsnSoft Base Framework Http Client</Title>
        <Description>Calls from one service to another over HTTP: the correlation id of the chain, retries that do not repeat a write, timeouts and a circuit breaker, a bearer token that is sent only to the hosts it is for, a guard against calls to the inside of the network, and the BaseResponse answer read into its payload or a typed failure.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>HsnSoft Base Framework Http Client Resilience</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HsnSoft.Base.Core\HsnSoft.Base.Core.csproj" />
    </ItemGroup>

</Project>
