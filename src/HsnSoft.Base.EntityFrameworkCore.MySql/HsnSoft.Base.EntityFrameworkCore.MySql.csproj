<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <AssemblyName>HsnSoft.Base.EntityFrameworkCore.MySql</AssemblyName>
        <PackageId>HsnSoft.Base.EntityFrameworkCore.MySql</PackageId>
        <RootNamespace />
        <Title>HsnSoft Base Framework EF Core MySQL</Title>
        <Description>MySQL for HsnSoft services: DbContext registration with retries and a health check.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>HsnSoft Base Framework EntityFrameworkCore MySQL</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(MicrosoftAspNetCorePackageVersion)" />
        <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HsnSoft.Base.EntityFrameworkCore\HsnSoft.Base.EntityFrameworkCore.csproj" />
    </ItemGroup>

</Project>
