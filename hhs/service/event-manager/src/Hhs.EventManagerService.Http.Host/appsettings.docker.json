{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrameworkLogger": {
    "LogLevel": "Debug",
    "IsGrayLogActive": true,
    "FilePath": "Logs/logs.txt",
    "GrayLog": {
      "Address": "infra-graylog",
      "Port": "12202"
    }
  },
  "ConnectionStrings": {
    "Mongo-EventManagerService": "mongodb://infra-mongo:27017/HHS_EventManagerService_Dev"
  },
  "AuthServer": {
    "Authority": "http://host.docker.internal:7100"
  },
  "RabbitMQ": {
    "Connection": {
      "HostName": "infra-rabbitmq",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest"
    }
  },
  "Redis": {
    "Configuration": "infra-redis:6379,ssl=False,allowAdmin=True,abortConnect=False,defaultDatabase=0,connectTimeout=500,connectRetry=3"
  }
}
