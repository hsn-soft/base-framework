{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (web) - Development",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Hhs.TextNormalizerService.Http.Host/bin/Debug/net10.0/Hhs.TextNormalizerService.Http.Host.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Hhs.TextNormalizerService.Http.Host",
            "stopAtEntry": false,
            "serverReadyAction": {
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "$1",
                "action": "openExternally"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5000"
            },
            "console": "integratedTerminal"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": ".NET Core Launch (web) - Docker",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Hhs.TextNormalizerService.Http.Host/bin/Debug/net10.0/Hhs.TextNormalizerService.Http.Host.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Hhs.TextNormalizerService.Http.Host",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Docker",
                "ASPNETCORE_URLS": "http://0.0.0.0:80"
            },
            "console": "integratedTerminal"
        }
    ]
}