{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Launch (AdManager)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-admanager",
            "program": "${workspaceFolder}/src/Hhs.FeedRService.AdManager.Http.Host/bin/Debug/net10.0/Hhs.FeedRService.AdManager.Http.Host.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Hhs.FeedRService.AdManager.Http.Host",
            "stopAtEntry": false,
            "serverReadyAction": {
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            "name": ".NET Launch (Weather)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-weather",
            "program": "${workspaceFolder}/src/Hhs.FeedRService.Weather.Http.Host/bin/Debug/net10.0/Hhs.FeedRService.Weather.Http.Host.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Hhs.FeedRService.Weather.Http.Host",
            "stopAtEntry": false,
            "serverReadyAction": {
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            "name": ".NET Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
