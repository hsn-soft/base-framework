<Project Sdk="Microsoft.NET.Sdk.Web">

    <Import Project="..\..\common.version.props"/>
    <Import Project="..\..\common.test.props"/>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <RootNamespace>Hhs.ContentService</RootNamespace>
        <Title>TechSummus Hhs Content Service</Title>
        <Product>TechSummus Hhs Content Service</Product>
        <Description>TechSummus Hhs Content Service</Description>
        <Authors>TechSummus</Authors>
        <Copyright>2025</Copyright>
        <NoWarn>$(NoWarn);CS1591;CS1998;</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!--        <PackageReference Include="Hhs.Shared.Hosting.Microservices" Version="$(HhsSharedVersion)" />-->
        <ProjectReference Include="..\..\..\shared\src\Hhs.Shared.Hosting.Microservices\Hhs.Shared.Hosting.Microservices.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hhs.ContentService.Application\Hhs.ContentService.Application.csproj"/>
        <ProjectReference Include="..\Hhs.ContentService.EntityFrameworkCore\Hhs.ContentService.EntityFrameworkCore.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\public_key.xml">
            <Link>public_key.xml</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\..\.dockerignore">
            <Link>.dockerignore</Link>
            <DependentUpon>Dockerfile</DependentUpon>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Logs\**"/>
        <Content Remove="Logs\**"/>
        <EmbeddedResource Remove="Logs\**"/>
        <None Remove="Logs\**"/>
    </ItemGroup>

</Project>