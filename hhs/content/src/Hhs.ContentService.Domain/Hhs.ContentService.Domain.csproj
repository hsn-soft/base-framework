<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.version.props"/>
    <Import Project="..\..\common.test.props"/>
    <Import Project="..\..\common.props"/>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageId>Hhs.ContentService.Domain</PackageId>
        <RootNamespace>Hhs.ContentService.Domain</RootNamespace>
        <Title>TechSummus Hhs Content Service Domain</Title>
        <Description>TechSummus Hhs Content Service Domain</Description>
        <PackageTags>TechSummus Hhs Content Service Domain</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="HsnSoft.Base.Ddd.Domain" Version="$(HsnSoftFrameworkVersion)"/>
        <PackageReference Include="HsnSoft.Base.EntityFrameworkCore.PostgreSql" Version="$(HsnSoftFrameworkVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Hhs.Shared.Helper" Version="$(HhsSharedVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Localization\ContentService\*.json"/>
        <Content Remove="Localization\ContentService\*.json"/>
    </ItemGroup>

</Project>
