<Project>
    <Import Project="$(MSBuildThisFileDirectory)common.versions.props" />

    <!--
        Shared settings of every library (NuGet package) project under src/.
        Import it from the project file:  <Import Project="..\..\common.props" />
        Test projects use common.test.props instead.
    -->

    <PropertyGroup Label="Language and build">
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <TreatWarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</TreatWarningsAsErrors>
        <!--
            Keep these as warnings even when TreatWarningsAsErrors is on (CI), so a build does not break without a code change:
            CS0618/CS0612       use of an [Obsolete] API (appears after a package or SDK upgrade)
            NU1901-NU1904       known vulnerability reported for a dependency (appears when a new advisory is published)
            Add a code here only when it should stay visible but must not fail the build.
        -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0618;CS0612;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
        <!-- CS1591: missing XML comment on public member -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Run the .editorconfig code style rules and the quality analyzers during dotnet build, not only in the IDE -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
    </PropertyGroup>

    <PropertyGroup Label="NuGet package">
        <Version>2026.10.40</Version>
        <Authors>HsnSoft</Authors>
        <Company>HsnSoft</Company>
        <Product>HsnSoft Base Framework</Product>
        <Copyright>Copyright (c) HsnSoft</Copyright>
        <IsPackable>true</IsPackable>
        <PackageProjectUrl>https://hhsahin.com/</PackageProjectUrl>
        <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
        <PackageIcon>assets\hsn-base.png</PackageIcon>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/hsn-soft/base-framework/</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <!-- Ship the symbol file (*.pdb) inside the .nupkg -->
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>

    <ItemGroup Label="Package content">
        <None Include="$(MSBuildThisFileDirectory)assets\hsn-base.png" Pack="true" Visible="false" PackagePath="assets\" />
    </ItemGroup>

    <ItemGroup Label="Tests">
        <!-- Convention: the tests of <Project> live in <Project>.Tests and may use its internals -->
        <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
    </ItemGroup>
</Project>
