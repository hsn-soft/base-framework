<?xml version="1.0" encoding="utf-8"?>
<!-- Shared coverage settings for local runs, CI and SonarQube. Scope: src only. -->
<RunSettings>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat Code Coverage">
                <Configuration>
                    <Format>cobertura,opencover</Format>
                    <Include>[HsnSoft.Base*]*</Include>
                    <Exclude>[HsnSoft.Base.Test*]*,[HsnSoft.Base.Sample*]*</Exclude>
                    <ExcludeByFile>**/Migrations/**,**/*Test*.cs,**/tmp/**,**/Tmp/**</ExcludeByFile>
                    <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>
