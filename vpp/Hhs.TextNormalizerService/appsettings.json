{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "text_normalizer_db"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "hhs.saga.exchange"
  },
  "OutlineProviders": {
    "FastBaseUrl": "http://localhost:5040",
    "QueueBaseUrl": "http://localhost:5041"
  },
  "Polling": {
    "Outline": {
      "IntervalSeconds": 5,
      "MaxAttempts": 10,
      "TimeoutSeconds": 30,
      "BackoffIntervalSeconds": 5
    }
  },
  "Retry": {
    "Normalizer": {
      "DelaySeconds": [60, 120, 300, 900],
      "MaxRetryCount": 4,
      "RetryOnTimeout": true,
      "RetryOnTransientError": true,
      "RetryWorkerIntervalSeconds": 10
    }
  }
}
