@ContentService_HostAddress = http://localhost:5000

### ============================================
### CUSTOMER CONTENT TEST SCENARIOS - All 8 Provider Combinations
### ============================================
### Testing all outline (2) × audio (2) × video (4) combinations
### ============================================

### ============================================
### SCENARIO 1: All Immediate (Fast Path)
### outline-fast (5s) + audio-quick (3s) + video-fast (5s)
### Expected: ~13s | Flow: All synchronous
### ============================================
POST {{ContentService_HostAddress}}/customer-contents
Content-Type: application/json

{
  "url": "https://example.com/s1-all-immediate",
  "outlineProviderKey": "outline-fast",
  "audioProviderKey": "audio-quick",
  "videoProviderKey": "video-fast"
}

### ============================================
### SCENARIO 2: Immediate (Fast) + Immediate + Sync Files
### outline-fast (5s) + audio-quick (3s) + video-sync (5s)
### Expected: ~13s | Flow: All synchronous with file passing
### ============================================
POST {{ContentService_HostAddress}}/customer-contents
Content-Type: application/json

{
  "url": "https://example.com/s2-immediate-sync",
  "outlineProviderKey": "outline-fast",
  "audioProviderKey": "audio-quick",
  "videoProviderKey": "video-sync"
}

