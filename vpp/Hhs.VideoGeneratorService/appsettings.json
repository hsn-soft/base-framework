{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "video_generator_db"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "hhs.saga.exchange"
  },
  "ProviderEndpoints": {
    "StorageBaseUrl": "http://localhost:5048",
    "AudioProviders": {
      "QuickBaseUrl": "http://localhost:5050",
      "HQBaseUrl": "http://localhost:5051"
    },
    "VideoProviders": {
      "FastExternalBaseUrl": "http://localhost:5060",
      "FastInternalBaseUrl": "http://localhost:5063",
      "QueueExternalBaseUrl": "http://localhost:5062",
      "QueueInternalBaseUrl": "http://localhost:5061"
    }
  },
  "VideoRetrySettings": {
    "DelaySeconds": [60, 120, 300, 900],
    "MaxRetryCount": 4,
    "RetryWorkerIntervalSeconds": 10,
    "ClaimFailRescheduleDelaySeconds": 10,
    "BatchSize": 50
  },
  "Polling": {
    "Audio": {
      "IntervalSeconds": 5,
      "MaxAttempts": 10,
      "TimeoutSeconds": 30,
      "BackoffIntervalSeconds": 5
    },
    "Video": {
      "IntervalSeconds": 5,
      "MaxAttempts": 10,
      "TimeoutSeconds": 60,
      "BackoffIntervalSeconds": 5
    }
  },
  "EntityDefaults": {
    "Video": {
      "AudioMaxRetryCount": 30,
      "AudioMaxProviderPollingCount": 60,
      "VideoMaxRetryCount": 30,
      "VideoMaxProviderPollingCount": 60
    }
  }
}
