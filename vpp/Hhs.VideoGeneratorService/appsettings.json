{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "video_generator_db"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "hhs.saga.exchange"
  },
  "Provider": {
    "Audio": {
      "AudioFast": {
        "BaseUrl": "http://localhost:5050",
        "APIKey": null,
        "AudioQuality": "high",
        "MaxDurationSeconds": 3600,
        "MaxFileSize": 52428800,
        "SendMailAfterGeneration": false
      },
      "AudioQueue": {
        "BaseUrl": "http://localhost:5051",
        "APIKey": null,
        "AudioQuality": "high",
        "MaxDurationSeconds": 3600,
        "MaxFileSize": 52428800,
        "SendMailAfterGeneration": false
      }
    },
    "Video": {
      "VideoFastExternal": {
        "BaseUrl": "http://localhost:5060",
        "APIKey": null,
        "AllowHorizontal": true,
        "AllowVertical": true,
        "Resolution": "1080p",
        "MediaFormat": "mp4"
      },
      "VideoFastInternal": {
        "BaseUrl": "http://localhost:5063",
        "APIKey": null,
        "AllowHorizontal": true,
        "AllowVertical": true,
        "Resolution": "1080p",
        "MediaFormat": "mp4"
      },
      "VideoQueueExternal": {
        "BaseUrl": "http://localhost:5062",
        "APIKey": null,
        "AllowHorizontal": true,
        "AllowVertical": true,
        "Resolution": "1080p",
        "MediaFormat": "mp4"
      },
      "VideoQueueInternal": {
        "BaseUrl": "http://localhost:5061",
        "APIKey": null,
        "AllowHorizontal": true,
        "AllowVertical": true,
        "Resolution": "1080p",
        "MediaFormat": "mp4"
      }
    },
    "Cdn": {
      "CdnLocalMinio": {
        "BaseUrl": "http://localhost:5070",
        "ApiKey": "local_minio_key",
        "ZoneName": "local-minio",
        "ZonePath": "media",
        "PathPrefix": "minio",
        "Storage": {
          "Type": "HttpCdn",
          "Url": "http://localhost:5070"
        }
      },
      "CdnBunnySelf": {
        "BaseUrl": "http://localhost:5071",
        "ApiKey": "bunny_self_key",
        "ZoneName": "bunny-self",
        "ZonePath": "media",
        "PathPrefix": "bunny",
        "Storage": {
          "Type": "HttpCdn",
          "Url": "http://localhost:5071"
        }
      },
      "CdnBunnyS3": {
        "BaseUrl": "http://localhost:5072",
        "ApiKey": "bunny_s3_key",
        "ZoneName": "bunny-s3",
        "ZonePath": "videos",
        "PathPrefix": "s3",
        "Storage": {
          "Type": "HttpCdn",
          "Url": "http://localhost:5072"
        }
      },
      "CdnAbc": {
        "BaseUrl": "http://localhost:5073",
        "ApiKey": "abc_key",
        "ZoneName": "abc",
        "ZonePath": "files",
        "PathPrefix": "abc",
        "Storage": {
          "Type": "HttpCdn",
          "Url": "http://localhost:5073"
        }
      }
    }
  },
  "VideoRetrySettings": {
    "DelaySeconds": [60, 120, 300, 900],
    "MaxRetryCount": 4,
    "RetryWorkerIntervalSeconds": 10,
    "ClaimFailRescheduleDelaySeconds": 10,
    "BatchSize": 50
  },
  "Polling": {
    "Audio": {
      "IntervalSeconds": 5,
      "MaxAttempts": 10,
      "TimeoutSeconds": 30,
      "BackoffIntervalSeconds": 5
    },
    "Video": {
      "IntervalSeconds": 5,
      "MaxAttempts": 10,
      "TimeoutSeconds": 60,
      "BackoffIntervalSeconds": 5
    }
  }
}
