@ContentService_HostAddress = http://localhost:7461
@timestamp = {{$timestamp}}

### ============================================
### CUSTOMER CONTENT TEST SCENARIOS - 12 Combinations
### ============================================
### 2 Outline × 2 Audio × 4 Video = 8 External Audio + 4 Internal Audio
### ============================================

### ============================================
### GROUP 1: EXTERNAL AUDIO SCENARIOS (8)
### Audio operations required → Full orchestration
### ============================================

### ============================================
### SCENARIO 1: Fast Outline + Quick Audio + Fast External Video
### outline-fast (5s) + audio-quick (3s) + video-fast-external (5s)
### Expected: ~13s | Flow: All synchronous
### ============================================
POST {{ContentService_HostAddress}}/customer-contents
Content-Type: application/json

{
  "url": "https://scenario.com/test1-{{$timestamp}}",
  "outlineProviderKey": "outline-fast",
  "audioProviderKey": "audio-quick",
  "videoProviderKey": "video-fast-external"
}

### ============================================
### SCENARIO 2: Fast Outline + HQ Audio + Fast External Video
### outline-fast (5s) + audio-hq (20s ready, 60s window) + video-fast-external (5s)
### Expected: ~28s | Flow: Outline → Audio (polling) → Video (parallel)
### ============================================
POST {{ContentService_HostAddress}}/customer-contents
Content-Type: application/json

{
  "url": "https://scenario.com/test2-{{$timestamp}}",
  "outlineProviderKey": "outline-fast",
  "audioProviderKey": "audio-hq",
  "videoProviderKey": "video-fast-external"
}

### ============================================
### SCENARIO 3: Fast Outline + Quick Audio + Queue External Video
### outline-fast (5s) + audio-quick (3s) + video-queue-external (30s ready, 150s window)
### Expected: ~38s | Flow: Outline → Audio → Video (polling)
### ============================================
POST {{ContentService_HostAddress}}/customer-contents
Content-Type: application/json

{
  "url": "https://scenario.com/test3-{{$timestamp}}",
  "outlineProviderKey": "outline-fast",
  "audioProviderKey": "audio-quick",
  "videoProviderKey": "video-queue-external"
}

