{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrameworkLogger": {
    "LogLevel": "Information",
    "IsGrayLogActive": true,
    "IsSelfLogActive": false,
    "FilePath": "Logs/logs.txt",
    "GrayLog": {
      "Address": "infra-graylog",
      "Port": "12202"
    }
  },
  "AuthServer": {
    "Authority": "http://host.docker.internal:7100"
  },
  "RemoteServices": {
    "Default": {
      "BaseUrl": "http://host.docker.internal:7200"
    }
  }
}
