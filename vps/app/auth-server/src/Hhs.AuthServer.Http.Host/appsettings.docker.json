{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrameworkLogger": {
    "LogLevel": "Information",
    "IsGrayLogActive": true,
    "IsSelfLogActive": false,
    "FilePath": "Logs/logs.txt",
    "GrayLog": {
      "Address": "infra-graylog",
      "Port": "12202",
      "SinkRefreshIntervalMinutes": 5
    }
  },
  "App": {
    "SelfUrl": "http://host.docker.internal:7100"
  },
  "AuthServerPolicies": {
    "AllowedCorsOrigins": [
      "http://host.docker.internal:7200",
      "http://localhost:7200",
      "https://localhost:7201",
      "http://host.docker.internal:7300",
      "http://localhost:7300",
      "https://localhost:7301",
      "http://host.docker.internal:7310",
      "http://localhost:7310"
    ]
  },
  "ConnectionStrings": {
    "EfCore-IdentityService": "Host=infra-postgres;Port=5432;Database=HHS_IdentityService_Dev;User ID=postgres;Password=postgres;Pooling=true;Connection Lifetime=0;"
  },
  "Redis": {
    "Configuration": "infra-redis:6379,ssl=False,allowAdmin=True,abortConnect=False,defaultDatabase=0,connectTimeout=500,connectRetry=3"
  },
  "AuthServer": {
    "Authority": "http://host.docker.internal:7100"
  },
  "TestSettings": "docker.hhsahin.com"
}
