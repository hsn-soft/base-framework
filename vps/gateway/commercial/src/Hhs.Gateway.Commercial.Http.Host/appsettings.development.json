{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrameworkLogger": {
    "LogLevel": "Debug",
    "IsGrayLogActive": true,
    "FilePath": "Logs/logs.txt",
    "GrayLog": {
      "Address": "127.0.0.1",
      "Port": "12202"
    }
  },
  "Gateway": {
    "PublicOrigin": "https://localhost:7201"
  },
  "GatewayPolicies": {
    "AllowedCorsOrigins": [
      "http://host.docker.internal:7300",
      "http://localhost:7300",
      "https://localhost:7301",
      "http://host.docker.internal:7310",
      "http://localhost:7310"
    ],
    "DocsRequireAuthenticatedUser": false,
    "DocsAllowInternalAnonymousAccess": true
  },
  "ServiceEndpoints": {
    "Services": {
      "administration-service": {
        "Origin": "http://localhost:7400"
      },
      "identity-service": {
        "Origin": "http://localhost:7410"
      },
      "content-service": {
        "Origin": "http://localhost:7450"
      },
      "text-normalizer-service": {
        "Origin": "http://localhost:7460"
      },
      "video-generator-service": {
        "Origin": "http://localhost:7470"
      },
      "event-manager-service": {
        "Origin": "http://localhost:7480"
      },
      "feedr-admanager-service": {
        "Origin": "http://localhost:7490"
      },
      "feedr-weather-service": {
        "Origin": "http://localhost:7492"
      }
    }
  }
}
