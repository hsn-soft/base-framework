{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrameworkLogger": {
    "LogLevel": "Information",
    "IsGrayLogActive": true,
    "IsSelfLogActive": false,
    "FilePath": "Logs/logs.txt",
    "GrayLog": {
      "Address": "infra-graylog",
      "Port": "12202",
      "SinkRefreshIntervalMinutes": 5
    }
  },
  "Gateway": {
    "PublicOrigin": "https://hhs-gateway-commercial.hhsahin.com"
  },
  "GatewayPolicies": {
    "AllowedCorsOrigins": [
      "http://host.docker.internal:7300",
      "https://hhs-app-commercial-stage.techsummus.com",
      "http://host.docker.internal:7310",
      "https://hhs-app-back-office-stage.techsummus.com"
    ]
  },
  "ServiceEndpoints": {
    "Services": {
      "administration-service": {
        "Origin": "http://hhs-service-administration-stage:8080"
      },
      "identity-service": {
        "Origin": "http://hhs-service-identity-stage:8080"
      },
      "content-service": {
        "Origin": "http://hhs-service-content-stage:8080"
      },
      "text-normalizer-service": {
        "Origin": "http://hhs-service-text-normalizer-stage:8080"
      },
      "video-generator-service": {
        "Origin": "http://hhs-service-video-generator-stage:8080"
      },
      "event-manager-service": {
        "Origin": "http://hhs-service-event-manager-stage:8080"
      },
      "feedr-admanager-service": {
        "Origin": "http://hhs-service-feedr-admanager-svc:8080"
      },
      "feedr-weather-service": {
        "Origin": "http://hhs-service-feedr-weather-stage:8080"
      }
    }
  }
}
