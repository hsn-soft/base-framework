{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrameworkLogger": {
    "LogLevel": "Information",
    "IsGrayLogActive": true,
    "FilePath": "Logs/logs.txt",
    "GrayLog": {
      "Address": "graylog-server-web.ns-graylog.svc.cluster.local",
      "Port": "12201"
    }
  },
  "Gateway": {
    "PublicOrigin": "https://hhs-gateway-commercial.techsummus.com"
  },
  "GatewayPolicies": {
    "AllowedCorsOrigins": [
      "https://hhs-app-commercial.techsummus.com",
      "https://hhs-app-back-office.techsummus.com"
    ],
    "DocsRequireAuthenticatedUser": false,
    "DocsAllowInternalAnonymousAccess": false
  },
  "ServiceEndpoints": {
    "Services": {
      "administration-service": {
        "Origin": "http://hhs-service-administration-svc:80"
      },
      "identity-service": {
        "Origin": "http://hhs-service-identity-svc:80"
      },
      "content-service": {
        "Origin": "http://hhs-service-content-svc:80"
      },
      "text-normalizer-service": {
        "Origin": "http://hhs-service-text-normalizer-svc:80"
      },
      "video-generator-service": {
        "Origin": "http://hhs-service-video-generator-svc:80"
      },
      "event-manager-service": {
        "Origin": "http://hhs-service-event-manager-svc:80"
      },
      "feedr-admanager-service": {
        "Origin": "http://hhs-service-feedr-admanager-svc:80"
      },
      "feedr-weather-service": {
        "Origin": "http://hhs-service-feedr-weather-svc:80"
      }
    }
  }
}
