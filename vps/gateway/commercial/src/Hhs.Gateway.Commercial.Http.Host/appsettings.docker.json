{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrameworkLogger": {
    "LogLevel": "Information",
    "IsGrayLogActive": true,
    "IsSelfLogActive": false,
    "FilePath": "Logs/logs.txt",
    "GrayLog": {
      "Address": "infra-graylog",
      "Port": "12202",
      "SinkRefreshIntervalMinutes": 5
    }
  },
  "Gateway": {
    "PublicOrigin": "http://host.docker.internal:7200"
  },
  "GatewayPolicies": {
    "AllowedCorsOrigins": [
      "http://host.docker.internal:7300",
      "http://localhost:7300",
      "https://localhost:7301",
      "http://host.docker.internal:7310",
      "http://localhost:7310"
    ],
    "DocsRequireAuthenticatedUser": false,
    "DocsAllowInternalAnonymousAccess": true
  },
  "ServiceEndpoints": {
    "Services": {
      "administration-service": {
        "Origin": "http://host.docker.internal:7400"
      },
      "identity-service": {
        "Origin": "http://host.docker.internal:7410"
      },
      "content-service": {
        "Origin": "http://host.docker.internal:7450"
      },
      "text-normalizer-service": {
        "Origin": "http://host.docker.internal:7460"
      },
      "video-generator-service": {
        "Origin": "http://host.docker.internal:7470"
      },
      "event-manager-service": {
        "Origin": "http://host.docker.internal:7480"
      },
      "feedr-admanager-service": {
        "Origin": "http://host.docker.internal:7490"
      },
      "feedr-weather-service": {
        "Origin": "http://host.docker.internal:7492"
      }
    }
  }
}
