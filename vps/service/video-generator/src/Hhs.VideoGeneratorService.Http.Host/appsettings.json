  "Polling": {
    "Audio": {
      "IntervalSeconds": 10,
      "MaxAttempts": 30,
      "TimeoutSeconds": 30,
      "BackoffIntervalSeconds": 10,
      "ErrorRescheduleDelaySeconds": 10
