{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrameworkLogger": {
    "LogLevel": "Information",
    "IsGrayLogActive": false,
    "FilePath": "Logs/logs.txt",
    "GrayLog": {
      "Address": "",
      "Port": "12201"
    }
  },
  "AllowedHosts": "*",
  "HostingSettings": {
    "IsEnabledRequestResponseLogger": false,
    "IsEnabledHealthCheckRequestLogger": false,
    "MaxLoggedRequestBodySizeBytes": 8192,
    "MaxLoggedResponseBodySizeBytes": 8192,
    "MaxLoggedHeaderValueLength": 128
  },
  "RabbitMQ": {
    "EventBus": {
      "ExchangeName": "HHS",
      "ConsumerClientName": "VideoGeneratorService",
      "ErrorClientName": "EventManagerService",
      "EventNamePrefix": "",
      "EventNameSuffix": "Eto"
    }
  },
  "SchedulerApiKey": "",
  "VideoGenerationSettings": {
    "SkipAudioGenerationOperation": false,
    "SkipVideoGenerationOperation": false
  },
  "SystemCdn": {
    "Selected": "cdn-bunny-s3",
    "LocalDownloadPath": "tmp-media"
  },
  "Provider": {
    "Audio": {
      "AudioFast": {
        "BaseUrl": "http://localhost:5050",
        "ApiKey": null,
        "AudioQuality": "high",
        "MaxDurationSeconds": 3600,
        "MaxFileSize": 52428800,
        "SendMailAfterGeneration": false
      },
      "AudioQueue": {
        "BaseUrl": "http://localhost:5051",
        "ApiKey": null,
        "AudioQuality": "high",
        "MaxDurationSeconds": 3600,
        "MaxFileSize": 52428800,
        "SendMailAfterGeneration": false
      },
      "AudioElevenLabs": {
        "BaseUrl": "https://api.elevenlabs.io/v1/text-to-speech/",
        "ApiKey": null,
        "AudioQuality": "high",
        "MaxDurationSeconds": 3600,
        "MaxFileSize": 52428800,
        "Model": "eleven_v3",
        "LanguageCode": "tr",
        "Stability": 0.5,
        "SimilarityBoost": 0.75,
        "Speed": 1.0,
        "VoiceId": "TX3LPaxmHKxFdv7VOQHJ"
      }
    },
    "Video": {
      "VideoQueueExternal": {
        "BaseUrl": "http://localhost:5062",
        "ApiKey": null,
        "AllowHorizontal": true,
        "AllowVertical": true,
        "Resolution": "1080p",
        "MediaFormat": "mp4"
      },
      "VideoQueueInternal": {
        "BaseUrl": "http://localhost:5061",
        "ApiKey": null,
        "AllowHorizontal": true,
        "AllowVertical": true,
        "Resolution": "1080p",
        "MediaFormat": "mp4"
      },
      "VideoCreatomate": {
        "BaseUrl": "https://api.creatomate.com",
        "ApiKey": null,
