        "BaseUrl": "http://localhost:5070",
        "ApiKey": ""
      },
      "CdnBunnySelf": {
        "BaseUrl": "https://storage.bunnycdn.com",
        "ApiKey": null,
        "StorageZoneName": "techsummus",
        "PullZoneUrl": ".b-cdn.net",
        "Path": ""
      },
      "CdnBunnyS3": {
        "BaseUrl": "https://s3.eu-central-003.backblazeb2.com",
        "ApiKey": null,
        "ApiSecret": null,
        "BucketName": "assets-techsummus",
        "PullZoneUrl": ".b-cdn.net",
        "Path": ""
      }
    }
