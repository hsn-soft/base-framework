{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrameworkLogger": {
    "LogLevel": "Information",
    "IsGrayLogActive": false,
    "IsSelfLogActive": false,
    "FilePath": "Logs/logs.txt",
    "GrayLog": {
      "Address": "",
      "Port": "12201"
    }
  },
  "AllowedHosts": "*",
  "HostingSettings": {
    "IsEnabledRequestResponseLogger": false,
    "IsEnabledHealthCheckRequestLogger": false,
    "MaxLoggedRequestBodySizeBytes": 8192,
    "MaxLoggedResponseBodySizeBytes": 8192,
    "MaxLoggedHeaderValueLength": 128
  },
  "RabbitMQ": {
    "EventBus": {
      "ExchangeName": "HHS",
      "ConsumerClientName": "TextNormalizerService",
      "ErrorClientName": "EventManagerService",
      "EventNamePrefix": "",
      "EventNameSuffix": "Eto"
    }
  },
  "SchedulerApiKey": "",
  "TextNormalizerSettings": {
    "SkipScrapingOperation": false,
    "SkipOutlineOperation": false,
    "UseReleaseTimeOldContentOutlineOperation": false,
    "UseStructuredOutput": false,
    "ForceReScrapeForAnalysis": false
  },
  "PuppeteerBrowserSettings": {
    "Headless": true,
    "Args": [
      "--no-sandbox",
      "--disable-gpu",
      "--disable-dev-shm-usage",
      "--disable-setuid-sandbox",

      "--disable-extensions",
      "--disable-blink-features=AutomationControlled",
      "--ignore-certificate-errors",
      "--allow-insecure-localhost",

      "--disable-infobars",
      "--window-size=1920,1080",
      "--start-maximized",

      "--no-default-browser-check",
      "--disable-background-networking",
      "--disable-webgl"
    ],
    "PageMaxCount": 10,
    "BrowserLaunchRetryCount": 3,
    "BrowserLaunchRetryDelaySeconds": 2,
    "WaitFreePageTimeoutMs": 30000,
    "DefaultPageTimeoutMs": 30000,
    "DefaultNavigationTimeoutMs": 60000,
    "ShutdownDrainTimeoutSeconds": 30
  },
  "Provider": {
    "Outline": {
      "OutlineFast": {
        "BaseUrl": "http://localhost:5040",
        "ApiKey": null,
        "Engine": "gpt-4",
        "StructureMode": "active"
      },
      "OutlineQueue": {
        "BaseUrl": "http://localhost:5041",
        "ApiKey": null,
        "Engine": "gpt-4",
        "StructureMode": "active"
      },
      "OutlineOpenAi": {
        "BaseUrl": "",
        "ApiKey": "",
        "Engine": "gpt-3.5-turbo",
        "StructuredEngine": "gpt-4o-mini",
        "StructureMode": "active"
      }
    }
  },
  "NormalizerRetrySettings": {
    "MaxRetryCount": 30,
    "DelaySeconds": [10, 10, 10, 10],
    "ClaimFailRescheduleDelaySeconds": 10
  },
  "Polling": {
    "Outline": {
      "IntervalSeconds": 10,
      "MaxAttempts": 30,
      "TimeoutSeconds": 30,
      "BackoffIntervalSeconds": 10,
      "ErrorRescheduleDelaySeconds": 10
    }
  }
}

