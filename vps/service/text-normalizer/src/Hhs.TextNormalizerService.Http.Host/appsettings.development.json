{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrameworkLogger": {
    "LogLevel": "Debug",
    "IsGrayLogActive": true,
    "FilePath": "Logs/logs.txt",
    "GrayLog": {
      "Address": "127.0.0.1",
      "Port": "12202"
    }
  },
  "ConnectionStrings": {
    "Mongo-TextNormalizerService": "mongodb://localhost:27017/HHS_TextNormalizerService_Dev"
  },
  "AuthServer": {
    "Authority": "https://localhost:7101"
  },
  "RabbitMQ": {
    "Connection": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest"
    }
  },
  "Redis": {
    "Configuration": "localhost:6379,ssl=False,allowAdmin=True,abortConnect=False,defaultDatabase=0,connectTimeout=500,connectRetry=3"
  },
  "PuppeteerBrowserSettings": {
    "Headless": true,
    "Args": [
      "--disable-web-security"
    ]
  },
  "TextNormalizerSettings": {
    "SkipScrapingOperation": false,
    "SkipOutlineOperation": false,
    "UseReleaseTimeOldContentOutlineOperation": true,
    "UseStructuredOutput": false,
    "ForceReScrapeAndReOutlineForAnalysis": false
  }
}
