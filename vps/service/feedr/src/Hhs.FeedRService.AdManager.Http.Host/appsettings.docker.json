{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrameworkLogger": {
    "LogLevel": "Debug",
    "IsGrayLogActive": true,
    "IsSelfLogActive": false,
    "FilePath": "Logs/logs.txt",
    "GrayLog": {
      "Address": "infra-graylog",
      "Port": "12202",
      "SinkRefreshIntervalMinutes": 5
    }
  },
  "ConnectionStrings": {
    "EfCore-FeedRService": "Host=host.docker.internal;Port=5432;Database=HHS_FeedRService_Dev;User ID=postgres;Password=postgres;Pooling=true;Connection Lifetime=0;",
    "Mongo-FeedRService": "mongodb://infra-mongo:27017/HHS_FeedRService_Dev"
  },
  "AuthServer": {
    "Authority": "http://host.docker.internal:7100"
  },
  "RabbitMQ": {
    "Connection": {
      "HostName": "host.docker.internal",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest"
    }
  },
  "Redis": {
    "Configuration": "host.docker.internal:6379,ssl=False,allowAdmin=True,abortConnect=False,defaultDatabase=0,connectTimeout=500,connectRetry=3"
  }
}
