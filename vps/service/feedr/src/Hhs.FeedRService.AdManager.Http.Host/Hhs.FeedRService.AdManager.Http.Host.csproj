<Project Sdk="Microsoft.NET.Sdk.Web">

    <Import Project="..\..\common.version.props" />
    <Import Project="..\..\common.test.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <RootNamespace>Hhs.FeedRService.AdManager</RootNamespace>
        <Title>TechSummus Hhs FeedR Service AdManager</Title>
        <Product>TechSummus Hhs FeedR Service AdManager</Product>
        <Description>TechSummus Hhs FeedR Service AdManager</Description>
        <Authors>TechSummus</Authors>
        <Copyright>2025</Copyright>
        <NoWarn>$(NoWarn);CS1591;CS1998;</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\..\shared\src\Hhs.Shared.Hosting.Microservices\Hhs.Shared.Hosting.Microservices.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hhs.FeedRService.Application\Hhs.FeedRService.Application.csproj"/>
        <ProjectReference Include="..\Hhs.FeedRService.MongoDb\Hhs.FeedRService.MongoDb.csproj"/>
        <ProjectReference Include="..\Hhs.FeedRService.EntityFrameworkCore\Hhs.FeedRService.EntityFrameworkCore.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\public_key.xml">
            <Link>public_key.xml</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\..\.dockerignore">
            <Link>.dockerignore</Link>
            <DependentUpon>Dockerfile</DependentUpon>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Logs\**"/>
        <Content Remove="Logs\**"/>
        <EmbeddedResource Remove="Logs\**"/>
        <None Remove="Logs\**"/>
    </ItemGroup>

</Project>