{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrameworkLogger": {
    "LogLevel": "Information",
    "IsGrayLogActive": false,
    "IsSelfLogActive": false,
    "FilePath": "Logs/logs.txt",
    "GrayLog": {
      "Address": "",
      "Port": "12201",
      "SinkRefreshIntervalMinutes": 5
    }
  },
  "Threading": {
    "MinimumWorkerThreads": 32,
    "MinimumCompletionPortThreads": 32
  },
  "AllowedHosts": "*",
  "HostingSettings": {
    "IsEnabledRequestResponseLogger": false,
    "IsEnabledHealthCheckRequestLogger": false,
    "MaxLoggedRequestBodySizeBytes": 8192,
    "MaxLoggedResponseBodySizeBytes": 8192,
    "MaxLoggedHeaderValueLength": 128
  },
  "RabbitMQ": {
    "EventBus": {
      "ExchangeName": "HHS",
      "ConsumerClientName": "ContentService",
      "ErrorClientName": "EventManagerService",
      "EventNamePrefix": "",
      "EventNameSuffix": "Eto"
    }
  },
  "SchedulerApiKey": "",
  "ContentOperationSettings": {
    "SkipDirectVideoGenerationApproveRules": false
  },
  "ContentRetrySettings": {
    "MaxRetryCount": 30,
    "DelaySeconds": [60, 120, 300, 900]
  }
}

