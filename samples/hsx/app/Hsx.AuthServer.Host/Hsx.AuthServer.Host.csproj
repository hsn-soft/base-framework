<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <RootNamespace>Hsx.AuthServer</RootNamespace>
    </PropertyGroup>

    <!--
        The auth server of the Hsx system: a web api that checks an email and a password against the users of the identity service (the same database) and issues the JWT access token every other Hsx host validates (the Jwt section is the same everywhere).
        It is a microservice like the others: what every Hsx microservice has comes from Hsx.Shared.Hosting.Microservices.
    -->

    <ItemGroup>
        <!-- the private key that signs the tokens (made with samples/scripts/generate-rsa-keys.cs, a secret, not in git) -->
        <Content Include="private_key.xml" Condition="Exists('private_key.xml')" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- the cache the host chose, the contract (the DTOs) and the claims of the tenants a token carries -->
        <ProjectReference Include="..\..\..\..\src\HsnSoft.Base.Caching.StackExchangeRedis\HsnSoft.Base.Caching.StackExchangeRedis.csproj" />
        <ProjectReference Include="..\..\..\..\src\HsnSoft.Base.Ddd.Application\HsnSoft.Base.Ddd.Application.csproj" />
        <ProjectReference Include="..\..\..\..\src\HsnSoft.Base.MultiTenancy.Authentication\HsnSoft.Base.MultiTenancy.Authentication.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\shared\Hsx.Shared.Helper\Hsx.Shared.Helper.csproj" />
        <ProjectReference Include="..\..\shared\Hsx.Shared.Hosting.Microservices\Hsx.Shared.Hosting.Microservices.csproj" />
        <ProjectReference Include="..\..\shared\Hsx.Shared.Localization\Hsx.Shared.Localization.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- the users and the way their passwords are checked: the identity service's, the same database -->
        <ProjectReference Include="..\..\service\identity\Hsx.IdentityService.EntityFrameworkCore\Hsx.IdentityService.EntityFrameworkCore.csproj" />
    </ItemGroup>

</Project>
