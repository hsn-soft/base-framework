{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/hsx-auth-server.txt"
  },
  "AllowedHosts": "*",
  "Health": {
    "CheckTimeout": "00:00:05",
    "Disabled": []
  },
  "Swagger": {
    "DisabledIn": [
      "Production",
      "Staging",
      "stage",
      "uat"
    ],
    "RoutePrefix": "swagger"
  },
  "EntityFramework": {
    "LogCommands": false
  },
  "Hosting": {
    "ShutdownTimeoutSeconds": 30,
    "ThreadPool": {
      "MinWorkerThreads": 32,
      "MinCompletionPortThreads": 32
    },
    "Kestrel": {
      "MaxRequestBodySize": 30000000,
      "MaxRequestBufferSize": 1048576,
      "MaxRequestHeadersTotalSize": 32768,
      "MaxRequestHeaderCount": 100,
      "RequestHeadersTimeout": "00:00:30",
      "KeepAliveTimeout": "00:02:10"
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    }
  },
  "SeedStartupConnections": "",
  "Jwt": {
    "Issuer": "hsx-auth",
    "Audience": "hsx-auth",
    "IssuedAudiences": [
      "hsx-auth",
      "hsx-gateway",
      "hsx-identity",
      "hsx-content",
      "hsx-text-normalizer",
      "hsx-video-generator"
    ],
    "AccessTokenMinutes": 15,
    "PublicKeyFile": "public_key.xml",
    "PrivateKeyFile": "private_key.xml"
  },
  "Redis": {
    "InstanceName": "hsx:"
  }
}
