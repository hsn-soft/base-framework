{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/hsx-auth-server.txt"
  },
  "AllowedHosts": "*",
  "Health": {
    "CheckTimeout": "00:00:05",
    "Disabled": []
  },
  "Swagger": {
    "DisabledIn": [
      "Production",
      "Staging",
      "stage",
      "uat"
    ],
    "RoutePrefix": "swagger"
  },
  "EntityFramework": {
    "LogCommands": false
  },
  "Hosting": {
    "ShutdownTimeoutSeconds": 30,
    "ThreadPool": {
      "MinWorkerThreads": 32,
      "MinCompletionPortThreads": 32
    },
    "Kestrel": {
      "MaxRequestBodySize": 30000000,
      "MaxRequestBufferSize": 1048576,
      "MaxRequestHeadersTotalSize": 32768,
      "MaxRequestHeaderCount": 100,
      "RequestHeadersTimeout": "00:00:30",
      "KeepAliveTimeout": "00:02:10"
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    },
    "Cors": {
      "AllowedOrigins": [],
      "AllowCredentials": true
    }
  },
  "SeedStartupConnections": "",
  "Jwt": {
    "Issuer": "hsx-auth",
    "Audience": "hsx-auth",
    "IssuedAudiences": [
      "hsx-auth",
      "hsx-gateway",
      "hsx-identity",
      "hsx-content",
      "hsx-text-normalizer",
      "hsx-video-generator"
    ],
    "AccessTokenMinutes": 15,
    "PublicKeyFile": "public_key.xml",
    "PrivateKeyFile": "private_key.xml"
  },
  "Redis": {
    "InstanceName": "hsx:"
  },
  "Auth": {
    "RefreshTokenDays": 7,
    "RefreshCookieName": "refreshToken",
    "RefreshCookiePath": "/",
    "RateLimits": {
      "GlobalPerMinute": 3000,
      "SignInPerMinute": 600,
      "RefreshPerMinute": 600
    },
    "Clients": [
      {
        "ClientId": "hsx-web",
        "Name": "Hsx applications of people (the commercial web, the smoke test, the Postman collection)",
        "Enabled": true,
        "RequireSecret": false,
        "Audiences": [
          "hsx-auth",
          "hsx-gateway",
          "hsx-identity",
          "hsx-content",
          "hsx-text-normalizer",
          "hsx-video-generator"
        ],
        "AllowUserSignIn": true,
        "AllowClientCredentials": false,
        "AllowOfflineAccess": true,
        "AccessTokenMinutes": 0
      },
      {
        "ClientId": "hsx-site",
        "Name": "A public site that reads static data with its own token (demo secret: hsx-site-demo-secret, never for a real system)",
        "Enabled": true,
        "RequireSecret": true,
        "SecretHashes": [
          {
            "Hash": "11C7BE374CB488116E22A47A2CAACF26549974489614B4188A7B3F71A4BCFC3D"
          }
        ],
        "Audiences": [
          "hsx-gateway",
          "hsx-content"
        ],
        "AllowUserSignIn": false,
        "AllowClientCredentials": true,
        "AllowOfflineAccess": false,
        "AccessTokenMinutes": 30
      },
      {
        "ClientId": "hsx-mobile",
        "Name": "A mobile application of people: a public client whose refresh token travels in the body",
        "Enabled": true,
        "RequireSecret": false,
        "Audiences": [
          "hsx-gateway",
          "hsx-content"
        ],
        "AllowUserSignIn": true,
        "AllowClientCredentials": false,
        "AllowOfflineAccess": true,
        "RefreshTokenInBody": true,
        "AccessTokenMinutes": 0
      }
    ]
  }
}
