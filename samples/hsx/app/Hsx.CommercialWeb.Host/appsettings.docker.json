{
  "Urls": "http://+:8080",
  "PersistentLogger": {
    "IsGrayLogActive": false,
    "GrayLog": {
      "Address": "host.docker.internal",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "Gateway": {
    "BaseUrl": "http://gateway-commercial:8080"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
