{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/hsx-gateway-commercial.txt"
  },
  "RequestLogging": {
    "Role": "Gateway"
  },
  "AllowedHosts": "*",
  "Health": {
    "CheckTimeout": "00:00:05",
    "Disabled": []
  },
  "Swagger": {
    "DisabledIn": [
      "Production",
      "Staging",
      "stage",
      "uat"
    ],
    "RoutePrefix": "swagger"
  },
  "Hosting": {
    "ShutdownTimeoutSeconds": 30
  },
  "Jwt": {
    "Issuer": "hsx-auth",
    "Audience": "hsx-gateway",
    "PublicKeyFile": "public_key.xml"
  },
  "GatewayPolicies": {
    "Kestrel": {
      "MaxRequestBodySizeBytes": 104857600,
      "RequestHeadersTimeoutSeconds": 15,
      "KeepAliveTimeoutSeconds": 60,
      "MaxRequestHeaderCount": 64,
      "MaxRequestHeadersTotalSizeBytes": 32768
    }
  },
  "ServiceEndpoints": {
    "Services": {
      "identity-service": {},
      "auth-server-service": {},
      "content-service": {},
      "text-normalizer-service": {},
      "video-generator-service": {}
    }
  },
  "ReverseProxyRoutes": {
    "Routes": {
      "identity-health": {
        "ClusterId": "identity-cluster",
        "MatchPath": "/identity-service/health",
        "DownstreamPathPattern": "/health/live"
      },
      "identity-api": {
        "ClusterId": "identity-cluster",
        "MatchPath": "/identity-service/v1/{**catch-all}",
        "DownstreamPathPattern": "/api/identity-service/v1/commercial/{**catch-all}",
        "ActivityTimeout": "00:00:30"
      },
      "auth-server-health": {
        "ClusterId": "auth-server-cluster",
        "MatchPath": "/auth-server/health",
        "DownstreamPathPattern": "/health/live"
      },
      "auth-server-api": {
        "ClusterId": "auth-server-cluster",
        "MatchPath": "/auth-server/v1/{**catch-all}",
        "DownstreamPathPattern": "/api/auth-server/v1/commercial/{**catch-all}",
        "ActivityTimeout": "00:00:30"
      },
      "content-health": {
        "ClusterId": "content-cluster",
        "MatchPath": "/content-service/health",
        "DownstreamPathPattern": "/health/live"
      },
      "content-api": {
        "ClusterId": "content-cluster",
        "MatchPath": "/content-service/v1/{**catch-all}",
        "DownstreamPathPattern": "/api/content-service/v1/commercial/{**catch-all}",
        "ActivityTimeout": "00:00:30"
      },
      "text-normalizer-health": {
        "ClusterId": "text-normalizer-cluster",
        "MatchPath": "/text-normalizer-service/health",
        "DownstreamPathPattern": "/health/live"
      },
      "text-normalizer-api": {
        "ClusterId": "text-normalizer-cluster",
        "MatchPath": "/text-normalizer-service/v1/{**catch-all}",
        "DownstreamPathPattern": "/api/text-normalizer-service/v1/commercial/{**catch-all}",
        "ActivityTimeout": "00:00:30"
      },
      "video-generator-health": {
        "ClusterId": "video-generator-cluster",
        "MatchPath": "/video-generator-service/health",
        "DownstreamPathPattern": "/health/live"
      },
      "video-generator-api": {
        "ClusterId": "video-generator-cluster",
        "MatchPath": "/video-generator-service/v1/{**catch-all}",
        "DownstreamPathPattern": "/api/video-generator-service/v1/commercial/{**catch-all}",
        "ActivityTimeout": "00:00:30"
      }
    }
  },
  "SwaggerGateway": {
    "Services": [
      {
        "Key": "identity",
        "DisplayName": "Identity Service API",
        "DownstreamPathPrefix": "/api/identity-service/v1/commercial",
        "GatewayPathPrefix": "/identity-service/v1"
      },
      {
        "Key": "auth-server",
        "DisplayName": "Auth Server API",
        "DownstreamPathPrefix": "/api/auth-server/v1/commercial",
        "GatewayPathPrefix": "/auth-server/v1"
      },
      {
        "Key": "content",
        "DisplayName": "Content Service API",
        "DownstreamPathPrefix": "/api/content-service/v1/commercial",
        "GatewayPathPrefix": "/content-service/v1"
      },
      {
        "Key": "text-normalizer",
        "DisplayName": "Text Normalizer Service API",
        "DownstreamPathPrefix": "/api/text-normalizer-service/v1/commercial",
        "GatewayPathPrefix": "/text-normalizer-service/v1"
      },
      {
        "Key": "video-generator",
        "DisplayName": "Video Generator Service API",
        "DownstreamPathPrefix": "/api/video-generator-service/v1/commercial",
        "GatewayPathPrefix": "/video-generator-service/v1"
      }
    ]
  },
  "Redis": {
    "InstanceName": "hsx:"
  }
}
