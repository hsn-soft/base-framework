                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/auth-server/v1/auth/login",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "auth-server",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"hsx-web\",\n  \"tenant\": \"system-tenant\",\n  \"account\": \"system-operator@hsx.local\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]));",
                  "pm.collectionVariables.set('operatorToken', body.payload.accessToken);"
