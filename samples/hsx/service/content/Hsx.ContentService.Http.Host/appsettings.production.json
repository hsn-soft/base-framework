{
  "Urls": "http://+:8080",
  "ConnectionStrings": {
    "EfCore-ContentService": "Host=host.docker.internal;Port=5432;Database=Hsx_Content_Prod;Username=postgres;Password=CHANGE_ME",
    "Redis": "host.docker.internal:6379"
  },
  "Redis": {
    "InstanceName": "hsx-prod:"
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "host.docker.internal",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Warning"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "RabbitMq": {
    "Connection": {
      "HostName": "host.docker.internal",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "VirtualHost": "hsx-prod"
    }
  }
}
