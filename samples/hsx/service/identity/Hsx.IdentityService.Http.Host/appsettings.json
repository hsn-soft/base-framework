{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/hsx-identity.txt"
  },
  "AllowedHosts": "*",
  "Health": {
    "CheckTimeout": "00:00:05",
    "Disabled": []
  },
  "Swagger": {
    "DisabledIn": [
      "Production",
      "Staging",
      "stage",
      "uat"
    ],
    "RoutePrefix": "swagger"
  },
  "EntityFramework": {
    "LogCommands": false
  },
  "Hosting": {
    "ShutdownTimeoutSeconds": 30,
    "ThreadPool": {
      "MinWorkerThreads": 32,
      "MinCompletionPortThreads": 32
    },
    "Kestrel": {
      "MaxRequestBodySize": 30000000,
      "MaxRequestBufferSize": 1048576,
      "MaxRequestHeadersTotalSize": 32768,
      "MaxRequestHeaderCount": 100,
      "RequestHeadersTimeout": "00:00:30",
      "KeepAliveTimeout": "00:02:10"
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    }
  },
  "SeedStartupConnections": "EfCore-IdentityService",
  "Jwt": {
    "Issuer": "hsx-auth",
    "Audience": "hsx-identity",
    "PublicKeyFile": "public_key.xml"
  },
  "Redis": {
    "InstanceName": "hsx:"
  },
  "RabbitMq": {
    "EventBus": {
      "ExchangeName": "HSX",
      "MaxHandlerAttempts": 3,
      "MaxConcurrentHandlers": 64,
      "PublisherChannelPoolSize": 4,
      "ConsumerClientName": "IdentityService",
      "ShutdownTimeout": "00:00:30"
    }
  },
  "Identity": {
    "TemporaryPassword": {
      "Lifetime": "1.00:00:00",
      "SamplePassword": "Hsx-Demo-123"
    }
  },
  "Paging": {
    "MaxResultCountLimit": 100
  },
  "Permissions": {
    "SyncMinutes": 5
  }
}
