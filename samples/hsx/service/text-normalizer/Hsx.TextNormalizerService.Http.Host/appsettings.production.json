{
  "Urls": "http://+:8080",
  "ConnectionStrings": {
    "Mongo-TextNormalizerService": "mongodb://host.docker.internal:27017/Hsx_TextNormalizer_Prod",
    "Redis": "host.docker.internal:6379"
  },
  "Redis": {
    "InstanceName": "hsx-prod:"
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "host.docker.internal",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Warning"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  }
}
