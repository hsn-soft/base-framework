{
  "Urls": "http://+:8080",
  "ConnectionStrings": {
    "Mongo-VideoGeneratorService": "mongodb://host.docker.internal:27017/Hsx_VideoGenerator_Uat",
    "Redis": "host.docker.internal:6379"
  },
  "Redis": {
    "InstanceName": "hsx-uat:"
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "host.docker.internal",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
