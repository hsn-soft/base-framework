# Sample applications: the root .editorconfig applies; these rules are library-design or micro-optimisation
# guidance that only adds noise to application code.
[*.cs]
# Names are part of the sample's vocabulary (Abc.Shared namespace)
dotnet_diagnostic.CA1716.severity = none
# LoggerMessage source generators are a performance optimisation, not needed here
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

# The migrations of EF Core are made by the tool (dotnet ef migrations add): they are not edited for style
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
