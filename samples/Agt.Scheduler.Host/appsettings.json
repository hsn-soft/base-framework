{
  "Urls": "http://localhost:5200",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrameworkLogger": {
    "LogLevel": "Debug",
    "PersistentMinimumLevel": "Information",
    "IsGrayLogActive": false,
    "IsSelfLogActive": true,
    "FilePath": "Logs/agt-scheduler.txt",
    "GrayLog": {
      "Address": "127.0.0.1",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Mongo": "mongodb://localhost:27017/agt_scheduler"
  },
  "Scheduler": {
    "Collection": "sample_records",
    "PollIntervalSeconds": 30,
    "LookbackMinutes": 5,
    "MaxLoggedIds": 100
  }
}
