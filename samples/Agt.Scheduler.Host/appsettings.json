{
  "Urls": "http://localhost:5200",
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Mongo": "mongodb://localhost:27017/agt_scheduler"
  },
  "Scheduler": {
    "Collection": "sample_records",
    "PollIntervalSeconds": 30,
    "LookbackMinutes": 5,
    "MaxLoggedIds": 100
  }
}
