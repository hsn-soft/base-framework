{
  "Urls": "http://localhost:5100",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "FrameworkLogger": {
    "LogLevel": "Debug",
    "PersistentMinimumLevel": "Information",
    "IsGrayLogActive": false,
    "IsSelfLogActive": true,
    "FilePath": "Logs/xyz-gateway.txt",
    "GrayLog": {
      "Address": "127.0.0.1",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    }
  },
  "RequestLogging": {
    "LogBodies": true
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "xyz-auth",
    "Audience": "xyz",
    "Key": "sample-only-signing-key-change-me-0123456789"
  },
  "RateLimit": {
    "RequestsPerMinute": 120
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "orders": {
        "ClusterId": "order",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "products": {
        "ClusterId": "product",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "shipments": {
        "ClusterId": "shipment",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/shipments/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5110"
          }
        }
      },
      "order": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5120"
          }
        }
      },
      "product": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5130"
          }
        }
      },
      "shipment": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5140"
          }
        }
      }
    }
  },
  "Redis": {
    "InstanceName": "xyz:"
  }
}
