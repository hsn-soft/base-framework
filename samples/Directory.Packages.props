<Project>
    <!-- Central package management: every sample project takes its package versions from here. -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.13" />
        <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
        <PackageVersion Include="StackExchange.Redis" Version="3.4.5" />
        <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    </ItemGroup>
</Project>
