<Project>
    <!-- Central package management for the sample projects. The framework projects under src/ manage their own versions. -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="CoreWCF.Http" Version="1.9.1" />
        <PackageVersion Include="CoreWCF.Primitives" Version="1.9.1" />
        <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />
        <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.13" />
    </ItemGroup>
</Project>
