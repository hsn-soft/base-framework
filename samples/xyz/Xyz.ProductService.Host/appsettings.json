{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/xyz-product.txt"
  },
  "AllowedHosts": "*",
  "Hosting": {
    "ShutdownTimeoutSeconds": 30
  },
  "Jwt": {
    "Issuer": "xyz-auth",
    "Audience": "xyz",
    "PublicKeyFile": "public_key.xml"
  },
  "Redis": {
    "InstanceName": "xyz:"
  },
  "Kafka": {
    "EventBus": {
      "ExchangeName": "XYZ",
      "MaxHandlerAttempts": 3,
      "ConsumerClientName": "ProductService",
      "ShutdownTimeout": "00:00:30"
    }
  }
}
