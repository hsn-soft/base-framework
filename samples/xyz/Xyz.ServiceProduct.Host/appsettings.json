{
  "Urls": "http://localhost:5130",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrameworkLogger": {
    "LogLevel": "Debug",
    "PersistentMinimumLevel": "Information",
    "IsGrayLogActive": false,
    "IsSelfLogActive": true,
    "FilePath": "Logs/xyz-product.txt",
    "GrayLog": {
      "Address": "127.0.0.1",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    }
  },
  "RequestLogging": {
    "LogBodies": true
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Mongo": "mongodb://localhost:27017/xyz_product",
    "Redis": "localhost:6379"
  },
  "RabbitMq": {
    "Connection": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest"
    },
    "EventBus": {
      "ExchangeName": "xyz.events",
      "MaxHandlerAttempts": 3,
      "ConsumerClientName": "product-service"
    }
  },
  "Jwt": {
    "Issuer": "xyz-auth",
    "Audience": "xyz",
    "Key": "sample-only-signing-key-change-me-0123456789"
  },
  "Redis": {
    "InstanceName": "xyz:"
  }
}
