{
  "Urls": "http://localhost:5120",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsGrayLogActive": false,
    "IsSelfLogActive": true,
    "FilePath": "Logs/xyz-order.txt",
    "GrayLog": {
      "Address": "127.0.0.1",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    }
  },
  "RequestLogging": {
    "LogBodies": true
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=xyz_order;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "RabbitMq": {
    "Connection": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest"
    },
    "EventBus": {
      "ExchangeName": "xyz.events",
      "MaxHandlerAttempts": 3,
      "ConsumerClientName": "order-service"
    }
  },
  "Jwt": {
    "Issuer": "xyz-auth",
    "Audience": "xyz",
    "Key": "sample-only-signing-key-change-me-0123456789"
  },
  "Redis": {
    "InstanceName": "xyz:"
  }
}
