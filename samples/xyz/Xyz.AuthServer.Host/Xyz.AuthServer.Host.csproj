<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
        The auth server of the Xyz system: it keeps the users (PostgreSQL), checks a user name and a password and issues the JWT access token and the refresh token every other Xyz host validates.
        What every Xyz microservice has (logging, the web api shell, JWT, Swagger, health, Redis, the Kafka event bus) comes from Xyz.Shared; the layers of the service (Domain, Application, Infrastructure)
        are folders of this project, not projects of their own.
    -->

    <PropertyGroup>
        <RootNamespace>Xyz.AuthServer</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- the texts of the domain (Domain/Localization/en.json, tr.json, ru.json), read by the localization at start -->
        <EmbeddedResource Include="Domain\Localization\*.json" />
    </ItemGroup>

    <ItemGroup>
        <!-- the private key that signs the tokens (made with scripts/generate-rsa-keys.cs, a secret, not in git) -->
        <Content Include="private_key.xml" Condition="Exists('private_key.xml')" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\src\HsnSoft.Base.Ddd.Application\HsnSoft.Base.Ddd.Application.csproj" />
        <ProjectReference Include="..\..\..\src\HsnSoft.Base.EntityFrameworkCore\HsnSoft.Base.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\..\..\src\HsnSoft.Base.EntityFrameworkCore.PostgreSql\HsnSoft.Base.EntityFrameworkCore.PostgreSql.csproj" />
        <ProjectReference Include="..\..\..\src\HsnSoft.Base.Logging.Serilog\HsnSoft.Base.Logging.Serilog.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Xyz.Shared\Xyz.Shared.csproj" />
    </ItemGroup>

</Project>
