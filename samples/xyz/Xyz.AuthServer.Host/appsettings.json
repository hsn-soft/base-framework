{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/xyz-auth-server.txt"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "xyz-auth",
    "Audience": "xyz",
    "PublicKeyFile": "public_key.xml",
    "AccessTokenMinutes": 15,
    "PrivateKeyFile": "private_key.xml"
  },
  "Redis": {
    "InstanceName": "xyz:"
  },
  "Kafka": {
    "TopicPrefix": "xyz.",
    "EventBus": {
      "ExchangeName": "XYZ",
      "MaxHandlerAttempts": 3,
      "ConsumerClientName": "AuthServer"
    }
  },
  "Auth": {
    "RefreshTokenDays": 7
  }
}
