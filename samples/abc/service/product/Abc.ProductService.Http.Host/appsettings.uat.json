{
  "Urls": "http://+:8080",
  "ConnectionStrings": {
    "Mongo-ProductService": "mongodb://host.docker.internal:27017/Abc_Product_Uat",
    "Mongo-StockService": "mongodb://host.docker.internal:27017/Abc_Stock_Uat",
    "Redis": "host.docker.internal:6379"
  },
  "Redis": {
    "InstanceName": "abc-uat:"
  },
  "RabbitMq": {
    "Connection": {
      "HostName": "host.docker.internal",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "VirtualHost": "uat"
    }
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "host.docker.internal",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
