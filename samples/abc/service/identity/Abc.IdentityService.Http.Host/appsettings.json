{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Debug",
    "PersistentMinimumLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/abc-identity.txt"
  },
  "AllowedHosts": "*",
  "Hosting": {
    "ShutdownTimeoutSeconds": 30
  },
  "Jwt": {
    "Issuer": "abc-auth",
    "Audience": "abc",
    "PublicKeyFile": "public_key.xml"
  },
  "Redis": {
    "InstanceName": "abc:"
  },
  "RabbitMq": {
    "EventBus": {
      "ExchangeName": "ABC",
      "MaxHandlerAttempts": 3,
      "ConsumerClientName": "IdentityService",
      "ShutdownTimeout": "00:00:30"
    }
  }
}
