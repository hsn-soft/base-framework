{
  "Urls": "http://localhost:5400",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Debug",
    "PersistentMinimumLevel": "Information",
    "IsGrayLogActive": false,
    "IsSelfLogActive": true,
    "FilePath": "Logs/abc-identity.txt",
    "GrayLog": {
      "Address": "127.0.0.1",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "abc-auth",
    "Audience": "abc",
    "Key": "abc-sample-only-signing-key-change-me-0123456789"
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=abc_identity;Username=postgres;Password=postgres"
  }
}
