{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Debug",
    "PersistentMinimumLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/abc-identity.txt"
  },
  "AllowedHosts": "*",
  "Health": {
    "CheckTimeout": "00:00:05",
    "Disabled": []
  },
  "Hosting": {
    "ShutdownTimeoutSeconds": 30,
    "ThreadPool": {
      "MinWorkerThreads": 32,
      "MinCompletionPortThreads": 32
    },
    "Kestrel": {
      "MaxRequestBodySize": 30000000,
      "MaxRequestBufferSize": 1048576,
      "MaxRequestHeadersTotalSize": 32768,
      "MaxRequestHeaderCount": 100,
      "RequestHeadersTimeout": "00:00:30",
      "KeepAliveTimeout": "00:02:10"
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    }
  },
  "SeedStartupConnections": "EfCore-IdentityService;EfCore-HistoryService",
  "Jwt": {
    "Issuer": "abc-auth",
    "Audience": "abc",
    "PublicKeyFile": "public_key.xml"
  },
  "Redis": {
    "InstanceName": "abc:"
  },
  "RabbitMq": {
    "EventBus": {
      "ExchangeName": "ABC",
      "MaxHandlerAttempts": 3,
      "ConsumerClientName": "IdentityService",
      "ShutdownTimeout": "00:00:30"
    }
  }
}
