{
  "Urls": "http://localhost:5440",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsGrayLogActive": false,
    "IsSelfLogActive": true,
    "FilePath": "Logs/abc-shipment.txt",
    "GrayLog": {
      "Address": "127.0.0.1",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "abc-auth",
    "Audience": "abc",
    "PublicKeyFile": "public_key.xml"
  },
  "ConnectionStrings": {
    "Mongo-ShipmentService": "mongodb://localhost:27017/abc_shipment",
    "EfCore-ShipmentHistoryService": "Host=localhost;Port=5432;Database=abc_shipment_history;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Redis": {
    "InstanceName": "abc:"
  },
  "RabbitMq": {
    "Connection": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest"
    },
    "EventBus": {
      "ExchangeName": "abc.events",
      "MaxHandlerAttempts": 3,
      "ConsumerClientName": "shipment-service"
    }
  }
}
