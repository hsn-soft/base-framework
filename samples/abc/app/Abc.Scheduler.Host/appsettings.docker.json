{
  "Urls": "http://+:8080",
  "PersistentLogger": {
    "IsGrayLogActive": false,
    "GrayLog": {
      "Address": "host.docker.internal",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "Scheduler": {
    "ApiKey": "CHANGE_ME",
    "Services": {
      "shipment-service": "http://shipment-service:8080"
    }
  }
}
