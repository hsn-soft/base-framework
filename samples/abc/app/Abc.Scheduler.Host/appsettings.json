{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Quartz": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/abc-scheduler.txt"
  },
  "AllowedHosts": "*",
  "Health": {
    "CheckTimeout": "00:00:05",
    "Disabled": []
  },
  "Hosting": {
    "ShutdownTimeoutSeconds": 30
  },
  "Scheduler": {
    "Jobs": [
      {
        "Name": "shipment-payment-summary",
        "Service": "shipment-service",
        "Path": "/api/shipment-service/v1/commercial/jobs/payment-summary",
        "Method": "POST",
        "Cron": "0 * * * * ?",
        "TriggerOnStartup": true,
        "TimeoutSeconds": 30
      }
    ]
  }
}
