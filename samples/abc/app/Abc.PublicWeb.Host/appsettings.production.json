{
  "Urls": "http://+:8080",
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "prod-graylog.abc.example.com",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Warning"
  },
  "Gateway": {
    "BaseUrl": "https://gateway-public.abc.example.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  }
}
