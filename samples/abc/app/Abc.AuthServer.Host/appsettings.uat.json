{
  "Urls": "http://+:8080",
  "ConnectionStrings": {
    "EfCore-IdentityService": "Server=host.docker.internal,1433;Database=Abc_Identity_Uat;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True",
    "EfCore-HistoryService": "Host=host.docker.internal;Port=5432;Database=Abc_History_Uat;Username=postgres;Password=CHANGE_ME",
    "Redis": "host.docker.internal:6379"
  },
  "Redis": {
    "InstanceName": "abc-uat:"
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "host.docker.internal",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
