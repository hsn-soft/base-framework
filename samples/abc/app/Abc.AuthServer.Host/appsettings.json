{
  "Urls": "http://localhost:5410",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsGrayLogActive": false,
    "IsSelfLogActive": true,
    "FilePath": "Logs/abc-auth-server.txt",
    "GrayLog": {
      "Address": "127.0.0.1",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "abc-auth",
    "Audience": "abc",
    "Key": "abc-sample-only-signing-key-change-me-0123456789",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "Users": [
      {
        "Username": "admin",
        "Password": "admin123",
        "Roles": [
          "admin",
          "customer"
        ]
      },
      {
        "Username": "alice",
        "Password": "alice123",
        "Roles": [
          "customer"
        ]
      }
    ]
  }
}
