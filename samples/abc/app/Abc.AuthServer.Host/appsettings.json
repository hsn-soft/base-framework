{
  "Urls": "http://localhost:5410",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsGrayLogActive": false,
    "IsSelfLogActive": true,
    "FilePath": "Logs/abc-auth-server.txt",
    "GrayLog": {
      "Address": "127.0.0.1",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "abc-auth",
    "Audience": "abc",
    "AccessTokenMinutes": 15,
    "PublicKeyFile": "public_key.xml",
    "PrivateKeyFile": "private_key.xml"
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=abc_identity;Username=postgres;Password=postgres"
  }
}
