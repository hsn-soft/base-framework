{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/abc-auth-server.txt"
  },
  "AllowedHosts": "*",
  "Health": {
    "CheckTimeout": "00:00:05",
    "Disabled": []
  },
  "Hosting": {
    "ShutdownTimeoutSeconds": 30
  },
  "SeedStartupConnections": "",
  "Jwt": {
    "Issuer": "abc-auth",
    "Audience": "abc",
    "AccessTokenMinutes": 15,
    "PublicKeyFile": "public_key.xml",
    "PrivateKeyFile": "private_key.xml"
  },
  "Redis": {
    "InstanceName": "abc:"
  }
}
