{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/abc-gateway-public.txt"
  },
  "RequestLogging": {
    "Role": "Gateway"
  },
  "AllowedHosts": "*",
  "Hosting": {
    "ShutdownTimeoutSeconds": 30
  },
  "GatewayPolicies": {
    "Kestrel": {
      "MaxRequestBodySizeBytes": 104857600,
      "RequestHeadersTimeoutSeconds": 15,
      "KeepAliveTimeoutSeconds": 60,
      "MaxRequestHeaderCount": 64,
      "MaxRequestHeadersTotalSizeBytes": 32768
    }
  },
  "ServiceEndpoints": {
    "Services": {
      "identity-service": {}
    }
  },
  "ReverseProxyRoutes": {
    "Routes": {
      "identity-health": {
        "ClusterId": "identity-cluster",
        "MatchPath": "/identity-service/health",
        "DownstreamPathPattern": "/health/live"
      },
      "identity-api": {
        "ClusterId": "identity-cluster",
        "MatchPath": "/identity-service/v1/{**catch-all}",
        "DownstreamPathPattern": "/api/identity-service/v1/public/{**catch-all}",
        "ActivityTimeout": "00:00:30"
      }
    }
  },
  "SwaggerGateway": {
    "Services": [
      {
        "Key": "identity",
        "DisplayName": "Identity Service API",
        "DownstreamPathPrefix": "/api/identity-service/v1/public",
        "GatewayPathPrefix": "/identity-service/v1"
      }
    ]
  }
}
