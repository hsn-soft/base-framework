{
  "Urls": "http://+:8080",
  "PersistentLogger": {
    "IsGrayLogActive": false,
    "GrayLog": {
      "Address": "graylog",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "GatewayPolicies": {
    "TrustedProxyIps": [
      "172.18.0.1"
    ]
  },
  "ServiceEndpoints": {
    "Services": {
      "identity-service": {
        "Origin": "http://identity-service:8080"
      }
    }
  },
  "SwaggerGateway": {
    "Services": [
      {
        "Origin": "http://identity-service:8080"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
