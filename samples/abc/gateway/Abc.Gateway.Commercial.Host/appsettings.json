{
  "Urls": "http://localhost:5500",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsGrayLogActive": false,
    "IsSelfLogActive": true,
    "FilePath": "Logs/abc-gateway-commercial.txt",
    "GrayLog": {
      "Address": "127.0.0.1",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    }
  },
  "RequestLogging": {
    "Role": "Gateway"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "abc-auth",
    "Audience": "abc",
    "PublicKeyFile": "public_key.xml"
  },
  "GatewayPolicies": {
    "TrustedProxyIps": [
      "127.0.0.1",
      "::1"
    ],
    "Kestrel": {
      "MaxRequestBodySizeBytes": 104857600,
      "RequestHeadersTimeoutSeconds": 15,
      "KeepAliveTimeoutSeconds": 60,
      "MaxRequestHeaderCount": 64,
      "MaxRequestHeadersTotalSizeBytes": 32768
    }
  },
  "ServiceEndpoints": {
    "Services": {
      "identity-service": {
        "Origin": "http://localhost:5400"
      },
      "auth-server-service": {
        "Origin": "http://localhost:5410"
      },
      "order-service": {
        "Origin": "http://localhost:5420"
      },
      "product-service": {
        "Origin": "http://localhost:5430"
      },
      "shipment-service": {
        "Origin": "http://localhost:5440"
      }
    }
  },
  "ReverseProxyRoutes": {
    "Routes": {
      "identity-health": {
        "ClusterId": "identity-cluster",
        "MatchPath": "/identity-service/health",
        "DownstreamPathPattern": "/health/live"
      },
      "identity-api": {
        "ClusterId": "identity-cluster",
        "MatchPath": "/identity-service/v1/{**catch-all}",
        "DownstreamPathPattern": "/api/identity-service/v1/commercial/{**catch-all}",
        "ActivityTimeout": "00:00:30"
      },
      "auth-server-health": {
        "ClusterId": "auth-server-cluster",
        "MatchPath": "/auth-server/health",
        "DownstreamPathPattern": "/health/live"
      },
      "auth-server-api": {
        "ClusterId": "auth-server-cluster",
        "MatchPath": "/auth-server/v1/{**catch-all}",
        "DownstreamPathPattern": "/api/auth-server/v1/commercial/{**catch-all}",
        "ActivityTimeout": "00:00:30"
      },
      "order-health": {
        "ClusterId": "order-cluster",
        "MatchPath": "/order-service/health",
        "DownstreamPathPattern": "/health/live"
      },
      "order-api": {
        "ClusterId": "order-cluster",
        "MatchPath": "/order-service/v1/{**catch-all}",
        "DownstreamPathPattern": "/api/order-service/v1/commercial/{**catch-all}",
        "ActivityTimeout": "00:00:30"
      },
      "product-health": {
        "ClusterId": "product-cluster",
        "MatchPath": "/product-service/health",
        "DownstreamPathPattern": "/health/live"
      },
      "product-api": {
        "ClusterId": "product-cluster",
        "MatchPath": "/product-service/v1/{**catch-all}",
        "DownstreamPathPattern": "/api/product-service/v1/commercial/{**catch-all}",
        "ActivityTimeout": "00:00:30"
      },
      "shipment-health": {
        "ClusterId": "shipment-cluster",
        "MatchPath": "/shipment-service/health",
        "DownstreamPathPattern": "/health/live"
      },
      "shipment-api": {
        "ClusterId": "shipment-cluster",
        "MatchPath": "/shipment-service/v1/{**catch-all}",
        "DownstreamPathPattern": "/api/shipment-service/v1/commercial/{**catch-all}",
        "ActivityTimeout": "00:00:30"
      }
    }
  },
  "SwaggerGateway": {
    "Services": [
      {
        "Key": "identity",
        "DisplayName": "Identity Service API",
        "Origin": "http://localhost:5400",
        "DownstreamPathPrefix": "/api/identity-service/v1/commercial",
        "GatewayPathPrefix": "/identity-service/v1"
      },
      {
        "Key": "auth-server",
        "DisplayName": "Auth Server API",
        "Origin": "http://localhost:5410",
        "DownstreamPathPrefix": "/api/auth-server/v1/commercial",
        "GatewayPathPrefix": "/auth-server/v1"
      },
      {
        "Key": "order",
        "DisplayName": "Order Service API",
        "Origin": "http://localhost:5420",
        "DownstreamPathPrefix": "/api/order-service/v1/commercial",
        "GatewayPathPrefix": "/order-service/v1"
      },
      {
        "Key": "product",
        "DisplayName": "Product Service API",
        "Origin": "http://localhost:5430",
        "DownstreamPathPrefix": "/api/product-service/v1/commercial",
        "GatewayPathPrefix": "/product-service/v1"
      },
      {
        "Key": "shipment",
        "DisplayName": "Shipment Service API",
        "Origin": "http://localhost:5440",
        "DownstreamPathPrefix": "/api/shipment-service/v1/commercial",
        "GatewayPathPrefix": "/shipment-service/v1"
      }
    ]
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Redis": {
    "InstanceName": "abc:"
  }
}
