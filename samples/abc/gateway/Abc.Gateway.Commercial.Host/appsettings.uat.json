{
  "Urls": "http://+:8080",
  "ConnectionStrings": {
    "Redis": "host.docker.internal:6379"
  },
  "Redis": {
    "InstanceName": "abc-uat:"
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "host.docker.internal",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "GatewayPolicies": {
    "TrustedProxyIps": [
      "172.18.0.1"
    ]
  },
  "ServiceEndpoints": {
    "Services": {
      "identity-service": {
        "Origin": "http://identity-service:8080"
      },
      "auth-server-service": {
        "Origin": "http://auth-server-service:8080"
      },
      "order-service": {
        "Origin": "http://order-service:8080"
      },
      "product-service": {
        "Origin": "http://product-service:8080"
      },
      "shipment-service": {
        "Origin": "http://shipment-service:8080"
      }
    }
  },
  "SwaggerGateway": {
    "Services": [
      {
        "Origin": "http://identity-service:8080"
      },
      {
        "Origin": "http://auth-server-service:8080"
      },
      {
        "Origin": "http://order-service:8080"
      },
      {
        "Origin": "http://product-service:8080"
      },
      {
        "Origin": "http://shipment-service:8080"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
