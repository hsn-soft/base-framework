{
  "Urls": "http://+:8080",
  "ConnectionStrings": {
    "Redis": "prod-redis.abc.example.com:6379"
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "prod-graylog.abc.example.com",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Warning"
  },
  "GatewayPolicies": {
    "TrustedProxyIps": [
      "10.0.0.10"
    ]
  },
  "ServiceEndpoints": {
    "Services": {
      "identity-service": {
        "Origin": "https://identity-service.abc.example.com"
      },
      "auth-server-service": {
        "Origin": "https://auth-server-service.abc.example.com"
      },
      "order-service": {
        "Origin": "https://order-service.abc.example.com"
      },
      "product-service": {
        "Origin": "https://product-service.abc.example.com"
      },
      "shipment-service": {
        "Origin": "https://shipment-service.abc.example.com"
      }
    }
  },
  "SwaggerGateway": {
    "Services": [
      {
        "Origin": "https://identity-service.abc.example.com"
      },
      {
        "Origin": "https://auth-server-service.abc.example.com"
      },
      {
        "Origin": "https://order-service.abc.example.com"
      },
      {
        "Origin": "https://product-service.abc.example.com"
      },
      {
        "Origin": "https://shipment-service.abc.example.com"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  }
}
