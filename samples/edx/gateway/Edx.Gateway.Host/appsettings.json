{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/edx-gateway.txt"
  },
  "RequestLogging": {
    "Role": "Gateway"
  },
  "AllowedHosts": "*",
  "Hosting": {
    "ShutdownTimeoutSeconds": 30
  },
  "Jwt": {
    "Issuer": "edx-auth",
    "Audience": "edx",
    "PublicKeyFile": "public_key.xml"
  },
  "GatewayPolicies": {
    "Kestrel": {
      "MaxRequestBodySizeBytes": 104857600,
      "RequestHeadersTimeoutSeconds": 15,
      "KeepAliveTimeoutSeconds": 60,
      "MaxRequestHeaderCount": 64,
      "MaxRequestHeadersTotalSizeBytes": 32768
    }
  },
  "ServiceEndpoints": {
    "Services": {
      "auth-server-service": {},
      "intake-service": {},
      "intake-grpc-service": {},
      "invoice-service": {},
      "identity-service": {}
    }
  },
  "ReverseProxyRoutes": {
    "Routes": {
      "auth-server-health": {
        "ClusterId": "auth-server-cluster",
        "MatchPath": "/auth-server/health",
        "DownstreamPathPattern": "/health/live"
      },
      "auth-server-api": {
        "ClusterId": "auth-server-cluster",
        "MatchPath": "/auth-server/v1/{**catch-all}",
        "DownstreamPathPattern": "/api/auth-server/v1/commercial/{**catch-all}",
        "ActivityTimeout": "00:00:30"
      },
      "intake-health": {
        "ClusterId": "intake-cluster",
        "MatchPath": "/intake-service/health",
        "DownstreamPathPattern": "/health/live"
      },
      "intake-api": {
        "ClusterId": "intake-cluster",
        "MatchPath": "/intake-service/v1/{**catch-all}",
        "DownstreamPathPattern": "/api/intake-service/v1/commercial/{**catch-all}",
        "ActivityTimeout": "00:05:00"
      },
      "intake-wcf": {
        "ClusterId": "intake-cluster",
        "MatchPath": "/intake-service/wcf/{**catch-all}",
        "DownstreamPathPattern": "/wcf/{**catch-all}",
        "ActivityTimeout": "00:05:00"
      },
      "intake-grpc": {
        "ClusterId": "intake-grpc-cluster",
        "MatchPath": "/edx.intake.v1.Intake/{**catch-all}",
        "DownstreamPathPattern": "/edx.intake.v1.Intake/{**catch-all}",
        "ActivityTimeout": "00:05:00",
        "Http2": true
      },
      "invoice-health": {
        "ClusterId": "invoice-cluster",
        "MatchPath": "/invoice-service/health",
        "DownstreamPathPattern": "/health/live"
      },
      "invoice-api": {
        "ClusterId": "invoice-cluster",
        "MatchPath": "/invoice-service/v1/{**catch-all}",
        "DownstreamPathPattern": "/api/invoice-service/v1/commercial/{**catch-all}",
        "ActivityTimeout": "00:00:30"
      },
      "identity-health": {
        "ClusterId": "identity-cluster",
        "MatchPath": "/identity-service/health",
        "DownstreamPathPattern": "/health/live"
      },
      "identity-api": {
        "ClusterId": "identity-cluster",
        "MatchPath": "/identity-service/v1/{**catch-all}",
        "DownstreamPathPattern": "/api/identity-service/v1/commercial/{**catch-all}",
        "ActivityTimeout": "00:00:30"
      }
    }
  },
  "SwaggerGateway": {
    "Services": [
      {
        "Key": "auth-server",
        "DisplayName": "Auth Server API",
        "DownstreamPathPrefix": "/api/auth-server/v1/commercial",
        "GatewayPathPrefix": "/auth-server/v1"
      },
      {
        "Key": "identity",
        "DisplayName": "Identity Service API",
        "DownstreamPathPrefix": "/api/identity-service/v1/commercial",
        "GatewayPathPrefix": "/identity-service/v1"
      },
      {
        "Key": "intake",
        "DisplayName": "Intake Service API",
        "DownstreamPathPrefix": "/api/intake-service/v1/commercial",
        "GatewayPathPrefix": "/intake-service/v1"
      },
      {
        "Key": "invoice",
        "DisplayName": "Invoice Service API",
        "DownstreamPathPrefix": "/api/invoice-service/v1/commercial",
        "GatewayPathPrefix": "/invoice-service/v1"
      }
    ]
  },
  "Redis": {
    "InstanceName": "edx:"
  }
}
