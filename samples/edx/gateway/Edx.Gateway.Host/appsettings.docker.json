{
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      }
    }
  },
  "ConnectionStrings": {
    "Redis": "redis:6379"
  },
  "PersistentLogger": {
    "IsGrayLogActive": false,
    "GrayLog": {
      "Address": "graylog",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "GatewayPolicies": {
    "TrustedProxyIps": [
      "172.18.0.1"
    ]
  },
  "ServiceEndpoints": {
    "Services": {
      "auth-server-service": {
        "Origin": "http://auth-server-service:8080"
      },
      "invoice-service": {
        "Origin": "http://invoice-service:8080"
      },
      "identity-service": {
        "Origin": "http://identity-service:8080"
      },
      "signer-service": {
        "Origin": "http://signer-service:8080"
      }
    }
  },
  "SwaggerGateway": {
    "Services": [
      {
        "Origin": "http://auth-server-service:8080"
      },
      {
        "Origin": "http://identity-service:8080"
      },
      {
        "Origin": "http://invoice-service:8080"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
