{
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      }
    }
  },
  "ConnectionStrings": {
    "Redis": "stage-redis.edx.example.com:6379"
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "stage-graylog.edx.example.com",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "GatewayPolicies": {
    "TrustedProxyIps": [
      "10.0.0.1"
    ]
  },
  "ServiceEndpoints": {
    "Services": {
      "auth-server-service": {
        "Origin": "http://auth-server-service.stage.edx.example.com"
      },
      "invoice-service": {
        "Origin": "http://invoice-service.stage.edx.example.com"
      },
      "identity-service": {
        "Origin": "http://identity-service.stage.edx.example.com"
      },
      "signer-service": {
        "Origin": "http://signer-service.stage.edx.example.com"
      }
    }
  },
  "SwaggerGateway": {
    "Services": [
      {
        "Origin": "http://auth-server-service.stage.edx.example.com"
      },
      {
        "Origin": "http://identity-service.stage.edx.example.com"
      },
      {
        "Origin": "http://invoice-service.stage.edx.example.com"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
