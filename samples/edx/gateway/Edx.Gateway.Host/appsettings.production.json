{
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  },
  "ConnectionStrings": {
    "Redis": "prod-redis.edx.example.com:6379"
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "prod-graylog.edx.example.com",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Warning"
  },
  "GatewayPolicies": {
    "TrustedProxyIps": [
      "10.0.0.1"
    ]
  },
  "ServiceEndpoints": {
    "Services": {
      "auth-server-service": {
        "Origin": "http://auth-server-service.production.edx.example.com"
      },
      "intake-service": {
        "Origin": "http://intake-service.production.edx.example.com"
      },
      "intake-grpc-service": {
        "Origin": "http://intake-grpc-service.production.edx.example.com"
      },
      "invoice-service": {
        "Origin": "http://invoice-service.production.edx.example.com"
      },
      "identity-service": {
        "Origin": "http://identity-service.production.edx.example.com"
      },
      "intake-wcf-service": {
        "Origin": "http://intake-wcf-service.production.edx.example.com"
      }
    }
  },
  "SwaggerGateway": {
    "Services": [
      {
        "Origin": "http://auth-server-service.production.edx.example.com"
      },
      {
        "Origin": "http://identity-service.production.edx.example.com"
      },
      {
        "Origin": "http://intake-service.production.edx.example.com"
      },
      {
        "Origin": "http://invoice-service.production.edx.example.com"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  }
}
