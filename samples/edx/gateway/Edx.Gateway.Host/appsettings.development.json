{
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://localhost:5600",
        "Protocols": "Http1"
      }
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "PersistentLogger": {
    "IsGrayLogActive": false,
    "GrayLog": {
      "Address": "127.0.0.1",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    }
  },
  "GatewayPolicies": {
    "TrustedProxyIps": [
      "127.0.0.1",
      "::1"
    ],
    "Cors": {
      "AllowedOrigins": [
        "http://localhost:4200"
      ]
    }
  },
  "ServiceEndpoints": {
    "Services": {
      "auth-server-service": {
        "Origin": "http://localhost:5500"
      },
      "invoice-service": {
        "Origin": "http://localhost:5520"
      },
      "identity-service": {
        "Origin": "http://localhost:5530"
      },
      "signer-service": {
        "Origin": "http://localhost:5550"
      }
    }
  },
  "SwaggerGateway": {
    "Services": [
      {
        "Origin": "http://localhost:5500"
      },
      {
        "Origin": "http://localhost:5530"
      },
      {
        "Origin": "http://localhost:5520"
      }
    ]
  }
}
