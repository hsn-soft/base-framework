{
  "Urls": "http://+:8080",
  "ConnectionStrings": {
    "Redis": "uat-redis.edx.example.com:6379",
    "Mongo-IntegrationService": "mongodb://edx_app:CHANGE_ME@uat-mongo.edx.example.com:27017/Edx_Invoice_Uat?authSource=admin"
  },
  "Kafka": {
    "BootstrapServers": "uat-kafka.edx.example.com:9092"
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "uat-graylog.edx.example.com",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Minio": {
    "Endpoint": "uat-minio.edx.example.com:9000",
    "UseSsl": true
  }
}
