{
  "Urls": "http://+:8080",
  "ConnectionStrings": {
    "Redis": "host.docker.internal:6379",
    "Mongo-IntegrationService": "mongodb://host.docker.internal:27017/Edx_IntegrationGib_Uat"
  },
  "Redis": {
    "InstanceName": "edx-uat:"
  },
  "Kafka": {
    "BootstrapServers": "host.docker.internal:9192"
  },
  "Minio": {
    "Endpoint": "host.docker.internal:9100",
    "UseSsl": false
  },
  "Storage": {
    "Container": "edx-integration-gib-invoice-uat"
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "host.docker.internal",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
