{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/edx-integration.txt"
  },
  "AllowedHosts": "*",
  "Hosting": {
    "ShutdownTimeoutSeconds": 30,
    "Kestrel": {
      "MaxRequestBodySize": 30000000,
      "MaxRequestBufferSize": 1048576,
      "MaxRequestHeadersTotalSize": 32768,
      "MaxRequestHeaderCount": 100,
      "RequestHeadersTimeout": "00:00:30",
      "KeepAliveTimeout": "00:02:10"
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    }
  },
  "SeedStartupConnections": "Mongo-IntegrationService",
  "Jwt": {
    "Issuer": "edx-auth",
    "Audience": "edx",
    "PublicKeyFile": "public_key.xml"
  },
  "Redis": {
    "InstanceName": "edx:"
  },
  "Kafka": {
    "EventBus": {
      "ExchangeName": "EDX",
      "MaxHandlerAttempts": 3,
      "ConsumerClientName": "IntegrationGibInvoiceApi",
      "ShutdownTimeout": "00:00:30"
    }
  },
  "Storage": {
    "Container": "edx-integration-gib-invoice"
  },
  "Import": {
    "MaxUnpackedBytes": 524288000
  },
  "Center": {
    "Endpoint": "http://localhost:5700/EFaturaMerkez/services/EFatura/",
    "UserListUrl": "http://localhost:5700/newUserPkListxml_full.zip",
    "RegisterNumber": "9999999999",
    "MaxMessageSize": 10485760,
    "SendRetryWaitSeconds": 60,
    "SendRetryLimit": 5,
    "StatusPollAfterSeconds": 300,
    "UserListRefreshMinutes": 60,
    "RequireSignature": true,
    "WorkerIntervalSeconds": 3,
    "WorkerBatchSize": 50
  }
}
