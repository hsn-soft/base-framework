{
  "Urls": "http://+:8080",
  "ConnectionStrings": {
    "Redis": "host.docker.internal:6379",
    "Mongo-IntegrationService": "mongodb://host.docker.internal:27017/Edx_IntegrationGib_Dev"
  },
  "Redis": {
    "InstanceName": "edx:"
  },
  "Kafka": {
    "BootstrapServers": "infra-kafka-node0:29092"
  },
  "Minio": {
    "Endpoint": "host.docker.internal:9100",
    "UseSsl": false
  },
  "Storage": {
    "Container": "edx-integration-gib-invoice"
  },
  "Center": {
    "Endpoint": "http://mock-center:8080/EFaturaMerkez/services/EFatura/",
    "UserListUrl": "http://mock-center:8080/newUserPkListxml_full.zip"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:6501"
    ]
  },
  "PersistentLogger": {
    "IsGrayLogActive": false,
    "GrayLog": {
      "Address": "host.docker.internal",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
