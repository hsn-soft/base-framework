{
  "Urls": "http://+:8080",
  "ConnectionStrings": {
    "Redis": "stage-redis.edx.example.com:6379",
    "Mongo-IntegrationService": "mongodb://edx_app:CHANGE_ME@stage-mongo.edx.example.com:27017/Edx_Invoice_Stage?authSource=admin"
  },
  "Kafka": {
    "BootstrapServers": "stage-kafka.edx.example.com:9092"
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "stage-graylog.edx.example.com",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Minio": {
    "Endpoint": "stage-minio.edx.example.com:9000",
    "UseSsl": true
  },
  "Center": {
    "Endpoint": "http://mock-center.stage.edx.example.com/EFaturaMerkez/services/EFatura/",
    "UserListUrl": "http://mock-center.stage.edx.example.com/newUserPkListxml_full.zip"
  }
}
