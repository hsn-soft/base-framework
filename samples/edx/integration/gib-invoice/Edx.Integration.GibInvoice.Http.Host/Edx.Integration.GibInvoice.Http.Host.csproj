<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
        The integration service of the Edx system, its REST host: the tenants' side of the e-invoice exchange with the center. It makes the envelope of every invoice that was signed and hands it to the center (the sender unit), follows what becomes of it, checks the envelopes the post box took
        from the center (invoices for the tenants, system responses about their envelopes) and answers them, keeps the list of the users it may send to, and lists the envelopes for the back office. The WCF service the center delivers to is a host of its own
        (Edx.Integration.GibInvoice.Wcf.Host) over the same application. What every Edx microservice has (logging, the web api shell, JWT, Swagger, health, Kafka) comes from Edx.Shared.Hosting.Microservices; the service adds its own parts here.
    -->

    <ItemGroup>
        <!-- the cache and the blob store the host chose -->
        <ProjectReference Include="..\..\..\..\..\src\HsnSoft.Base.BlobStoring.Minio\HsnSoft.Base.BlobStoring.Minio.csproj" />
        <ProjectReference Include="..\..\..\..\..\src\HsnSoft.Base.Caching.StackExchangeRedis\HsnSoft.Base.Caching.StackExchangeRedis.csproj" />
        <ProjectReference Include="..\..\..\..\..\src\HsnSoft.Base.MultiTenancy.Authentication\HsnSoft.Base.MultiTenancy.Authentication.csproj" />
        <ProjectReference Include="..\..\..\..\..\src\HsnSoft.Base.MultiTenancy.EventBus\HsnSoft.Base.MultiTenancy.EventBus.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\shared\Edx.Shared.Hosting.Microservices\Edx.Shared.Hosting.Microservices.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Edx.Integration.GibInvoice.Application\Edx.Integration.GibInvoice.Application.csproj" />
        <ProjectReference Include="..\Edx.Integration.GibInvoice.MongoDB\Edx.Integration.GibInvoice.MongoDB.csproj" />
    </ItemGroup>

</Project>
