{
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      }
    }
  },
  "ConnectionStrings": {
    "Mongo-FirmInvoiceService": "mongodb://edx_app:CHANGE_ME@mongo:27017/Edx_IntegrationFirm_Dev?authSource=admin",
    "Redis": "redis:6379"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092"
  },
  "Minio": {
    "Endpoint": "minio:9000",
    "UseSsl": false
  },
  "PersistentLogger": {
    "IsGrayLogActive": false,
    "GrayLog": {
      "Address": "graylog",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
