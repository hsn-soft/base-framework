<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
        The gRPC way into the firm invoice integration (ADR-0027): a client streams a zip in chunks or sends a model, and the host calls the same application service the REST host does. A host of its own, because it listens on HTTP/2
        and has its own scaling; it publishes the events of what it queued and consumes none.
    -->

    <ItemGroup>
        <Protobuf Include="Protos\firm_invoice.proto" GrpcServices="Server" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <!-- the cache and the blob store the host chose -->
        <ProjectReference Include="..\..\..\..\..\src\HsnSoft.Base.BlobStoring.Minio\HsnSoft.Base.BlobStoring.Minio.csproj" />
        <ProjectReference Include="..\..\..\..\..\src\HsnSoft.Base.Caching.StackExchangeRedis\HsnSoft.Base.Caching.StackExchangeRedis.csproj" />
        <ProjectReference Include="..\..\..\..\..\src\HsnSoft.Base.MultiTenancy.Authentication\HsnSoft.Base.MultiTenancy.Authentication.csproj" />
        <ProjectReference Include="..\..\..\..\..\src\HsnSoft.Base.MultiTenancy.EventBus\HsnSoft.Base.MultiTenancy.EventBus.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\shared\Edx.Shared.Hosting.Microservices\Edx.Shared.Hosting.Microservices.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Edx.Integration.FirmInvoice.Application\Edx.Integration.FirmInvoice.Application.csproj" />
        <ProjectReference Include="..\Edx.Integration.FirmInvoice.MongoDB\Edx.Integration.FirmInvoice.MongoDB.csproj" />
    </ItemGroup>

</Project>
