{
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://+:8080",
        "Protocols": "Http2"
      },
      "Health": {
        "Url": "http://+:8081",
        "Protocols": "Http1"
      }
    }
  },
  "ConnectionStrings": {
    "Mongo-FirmInvoiceService": "mongodb://host.docker.internal:27017/Edx_IntegrationFirm_Uat",
    "Redis": "host.docker.internal:6379"
  },
  "Redis": {
    "InstanceName": "edx-uat:"
  },
  "Kafka": {
    "BootstrapServers": "host.docker.internal:9192"
  },
  "Minio": {
    "Endpoint": "host.docker.internal:9100",
    "UseSsl": false
  },
  "Storage": {
    "Container": "edx-integration-firm-invoice-uat"
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "host.docker.internal",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
