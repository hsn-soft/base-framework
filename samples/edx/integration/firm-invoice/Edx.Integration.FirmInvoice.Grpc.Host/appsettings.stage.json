{
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://+:8080",
        "Protocols": "Http2"
      }
    }
  },
  "ConnectionStrings": {
    "Mongo-FirmInvoiceService": "mongodb://edx_app:CHANGE_ME@stage-mongo.edx.example.com:27017/Edx_IntegrationFirm_Stage?authSource=admin",
    "Redis": "stage-redis.edx.example.com:6379"
  },
  "Kafka": {
    "BootstrapServers": "stage-kafka.edx.example.com:9092"
  },
  "Minio": {
    "Endpoint": "stage-minio.edx.example.com:9000",
    "UseSsl": true
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "stage-graylog.edx.example.com",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
