{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/edx-firm-invoice.txt"
  },
  "AllowedHosts": "*",
  "Hosting": {
    "ShutdownTimeoutSeconds": 30,
    "Kestrel": {
      "MaxRequestBodySize": 30000000,
      "MaxRequestBufferSize": 1048576,
      "MaxRequestHeadersTotalSize": 32768,
      "MaxRequestHeaderCount": 100,
      "RequestHeadersTimeout": "00:00:30",
      "KeepAliveTimeout": "00:02:10"
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    }
  },
  "SeedStartupConnections": "Mongo-FirmInvoiceService",
  "Jwt": {
    "Issuer": "edx-auth",
    "Audience": "edx",
    "PublicKeyFile": "public_key.xml"
  },
  "Redis": {
    "InstanceName": "edx:"
  },
  "Kafka": {
    "EventBus": {
      "ExchangeName": "EDX",
      "MaxHandlerAttempts": 3,
      "ConsumerClientName": "IntegrationFirmInvoiceApi",
      "ShutdownTimeout": "00:00:30"
    }
  },
  "Storage": {
    "Container": "edx-integration-firm-invoice",
    "RootPath": ""
  },
  "FirmInvoice": {
    "ServiceName": "Edx.Integration.FirmInvoice.Http",
    "MaxUploadBytes": 104857600,
    "MaxArchiveEntries": 1000,
    "MaxUnpackedBytes": 524288000,
    "TabularExtensions": [
      ".txt",
      ".csv",
      ".xls",
      ".xlsx"
    ]
  }
}
