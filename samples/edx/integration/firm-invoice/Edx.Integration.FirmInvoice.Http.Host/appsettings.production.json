{
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      }
    }
  },
  "ConnectionStrings": {
    "Mongo-FirmInvoiceService": "mongodb://edx_app:CHANGE_ME@prod-mongo.edx.example.com:27017/Edx_IntegrationFirm_Prod?authSource=admin",
    "Redis": "prod-redis.edx.example.com:6379"
  },
  "Kafka": {
    "BootstrapServers": "prod-kafka.edx.example.com:9092"
  },
  "Minio": {
    "Endpoint": "prod-minio.edx.example.com:9000",
    "UseSsl": true
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "prod-graylog.edx.example.com",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Warning"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  }
}
