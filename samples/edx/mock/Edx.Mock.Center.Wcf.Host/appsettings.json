{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/edx-mock-center.txt"
  },
  "AllowedHosts": "*",
  "Hosting": {
    "ShutdownTimeoutSeconds": 30,
    "ThreadPool": {
      "MinWorkerThreads": 32,
      "MinCompletionPortThreads": 32
    },
    "Kestrel": {
      "MaxRequestBodySize": 30000000,
      "MaxRequestBufferSize": 1048576,
      "MaxRequestHeadersTotalSize": 32768,
      "MaxRequestHeaderCount": 100,
      "RequestHeadersTimeout": "00:00:30",
      "KeepAliveTimeout": "00:02:10"
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    }
  },
  "SeedStartupConnections": "Mongo-MockCenter",
  "Center": {
    "RegisterNumber": "9999999999",
    "Title": "GIB Merkez (mock)",
    "Alias": "urn:mail:defaultgb@merkez.efatura.mock",
    "Container": "edx-mock-center",
    "WorkerIntervalSeconds": 3,
    "WorkerBatchSize": 50,
    "ResendWaitSeconds": 7200,
    "ResendLimit": 4,
    "MaxReceivedMessageSize": 10485760,
    "AnswerPollAfterSeconds": 3600,
    "RequireSignature": true
  },
