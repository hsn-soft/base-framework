{
  "Urls": "http://+:8080",
  "Kafka": {
    "BootstrapServers": "kafka:9092"
  },
  "PersistentLogger": {
    "IsGrayLogActive": false,
    "GrayLog": {
      "Address": "graylog",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Minio": {
    "Endpoint": "minio:9000",
    "UseSsl": false
  }
}
