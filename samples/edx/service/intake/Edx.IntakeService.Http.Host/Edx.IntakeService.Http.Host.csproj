<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
        The intake service of the Edx system: customers send their files and models here, in the way they can: REST (JSON, multipart), gRPC or WCF (SOAP). All three call the same application service. What every Edx
        microservice has (logging, the web api shell, JWT, Swagger, health, Kafka) comes from Edx.Shared.Hosting.Microservices; the service adds its own parts here.
    -->

    <ItemGroup>
        <Protobuf Include="Protos\intake.proto" GrpcServices="Server" />
    </ItemGroup>

    <ItemGroup>
        <!-- the protocols the customers may choose: gRPC and WCF are entry points of this host, beside the controllers (ADR-0079) -->
        <PackageReference Include="CoreWCF.Http" />
        <PackageReference Include="CoreWCF.Primitives" />
        <PackageReference Include="Grpc.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <!-- the cache and the blob store the host chose -->
        <ProjectReference Include="..\..\..\..\..\src\HsnSoft.Base.BlobStoring.Minio\HsnSoft.Base.BlobStoring.Minio.csproj" />
        <ProjectReference Include="..\..\..\..\..\src\HsnSoft.Base.Caching.StackExchangeRedis\HsnSoft.Base.Caching.StackExchangeRedis.csproj" />
        <ProjectReference Include="..\..\..\..\..\src\HsnSoft.Base.MultiTenancy.Authentication\HsnSoft.Base.MultiTenancy.Authentication.csproj" />
        <ProjectReference Include="..\..\..\..\..\src\HsnSoft.Base.MultiTenancy.EventBus\HsnSoft.Base.MultiTenancy.EventBus.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\shared\Edx.Shared.Hosting.Microservices\Edx.Shared.Hosting.Microservices.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Edx.IntakeService.Application\Edx.IntakeService.Application.csproj" />
        <ProjectReference Include="..\Edx.IntakeService.MongoDB\Edx.IntakeService.MongoDB.csproj" />
    </ItemGroup>

</Project>
