{
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      }
    }
  },
  "ConnectionStrings": {
    "Mongo-IntakeService": "mongodb://edx_app:CHANGE_ME@uat-mongo.edx.example.com:27017/Edx_Intake_Uat?authSource=admin",
    "Redis": "uat-redis.edx.example.com:6379"
  },
  "Kafka": {
    "BootstrapServers": "uat-kafka.edx.example.com:9092"
  },
  "Minio": {
    "Endpoint": "uat-minio.edx.example.com:9000",
    "UseSsl": true
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "uat-graylog.edx.example.com",
      "Port": 12202,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Information"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
