{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/edx-intake.txt"
  },
  "AllowedHosts": "*",
  "Hosting": {
    "ShutdownTimeoutSeconds": 30
  },
  "Jwt": {
    "Issuer": "edx-auth",
    "Audience": "edx",
    "PublicKeyFile": "public_key.xml"
  },
  "Redis": {
    "InstanceName": "edx:"
  },
  "Kafka": {
    "EventBus": {
      "ExchangeName": "EDX",
      "MaxHandlerAttempts": 3,
      "ConsumerClientName": "IntakeService",
      "ShutdownTimeout": "00:00:30"
    }
  },
  "Storage": {
    "Container": "edx-intake",
    "RootPath": "inbox"
  },
  "Intake": {
    "MaxUploadBytes": 104857600,
    "MaxArchiveEntries": 1000,
    "MaxUnpackedBytes": 524288000,
    "TabularExtensions": [
      ".txt",
      ".csv",
      ".xls",
      ".xlsx"
    ]
  }
}
