{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/edx-identity.txt"
  },
  "AllowedHosts": "*",
  "Hosting": {
    "ShutdownTimeoutSeconds": 30
  },
  "Jwt": {
    "Issuer": "edx-auth",
    "Audience": "edx",
    "PublicKeyFile": "public_key.xml"
  },
  "Redis": {
    "InstanceName": "edx:"
  }
}
