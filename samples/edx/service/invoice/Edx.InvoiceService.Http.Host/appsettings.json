{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/edx-invoice.txt"
  },
  "AllowedHosts": "*",
  "Hosting": {
    "ShutdownTimeoutSeconds": 30
  },
  "SeedStartupConnections": "Mongo-InvoiceService",
  "Jwt": {
    "Issuer": "edx-auth",
    "Audience": "edx",
    "PublicKeyFile": "public_key.xml"
  },
  "Redis": {
    "InstanceName": "edx:"
  },
  "Kafka": {
    "EventBus": {
      "ExchangeName": "EDX",
      "MaxHandlerAttempts": 3,
      "ConsumerClientName": "InvoiceService",
      "ShutdownTimeout": "00:00:30"
    }
  },
  "Storage": {
    "Container": "edx-invoice"
  },
  "Import": {
    "MaxUnpackedBytes": 524288000
  }
}
