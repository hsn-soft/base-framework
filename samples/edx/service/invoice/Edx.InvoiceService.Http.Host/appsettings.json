{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PersistentLogger": {
    "LogLevel": "Information",
    "IsSelfLogActive": true,
    "FilePath": "Logs/edx-invoice.txt"
  },
  "AllowedHosts": "*",
  "Hosting": {
    "ShutdownTimeoutSeconds": 30,
    "ThreadPool": {
      "MinWorkerThreads": 32,
      "MinCompletionPortThreads": 32
    },
    "Kestrel": {
      "MaxRequestBodySize": 30000000,
      "MaxRequestBufferSize": 1048576,
      "MaxRequestHeadersTotalSize": 32768,
      "MaxRequestHeaderCount": 100,
      "RequestHeadersTimeout": "00:00:30",
      "KeepAliveTimeout": "00:02:10"
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    }
  },
  "SeedStartupConnections": "Mongo-InvoiceService",
  "Jwt": {
    "Issuer": "edx-auth",
    "Audience": "edx",
    "PublicKeyFile": "public_key.xml"
  },
  "Redis": {
    "InstanceName": "edx:"
  },
  "Kafka": {
    "EventBus": {
      "ExchangeName": "EDX",
      "MaxHandlerAttempts": 3,
      "ConsumerClientName": "InvoiceService",
      "ShutdownTimeout": "00:00:30"
    }
  },
  "Storage": {
    "Container": "edx-invoice"
  },
  "Import": {
    "MaxUnpackedBytes": 524288000
  }
}
