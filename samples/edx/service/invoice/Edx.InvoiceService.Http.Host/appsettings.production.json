{
  "Urls": "http://+:8080",
  "ConnectionStrings": {
    "Mongo-InvoiceService": "mongodb://host.docker.internal:27017/Edx_Invoice_Prod",
    "Redis": "host.docker.internal:6379"
  },
  "Redis": {
    "InstanceName": "edx-prod:"
  },
  "Kafka": {
    "BootstrapServers": "host.docker.internal:9292"
  },
  "Minio": {
    "Endpoint": "host.docker.internal:9100",
    "UseSsl": false
  },
  "Storage": {
    "Container": "edx-invoice-prod"
  },
  "PersistentLogger": {
    "IsGrayLogActive": true,
    "GrayLog": {
      "Address": "host.docker.internal",
      "Port": 12203,
      "SinkRefreshIntervalMinutes": 5
    },
    "LogLevel": "Warning"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  }
}
