{
  "Urls": "http://+:8080",
  "ConnectionStrings": {
    "EfCore-IdentityService": "Server=host.docker.internal,1433;Database=Edx_Identity_Dev;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True",
    "Redis": "host.docker.internal:6379"
  },
  "Redis": {
    "InstanceName": "edx:"
