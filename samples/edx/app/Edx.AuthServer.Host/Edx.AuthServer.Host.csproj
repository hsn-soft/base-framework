<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
        The auth server of the Edx system: a web api that checks a tenant, a user name and a password against the users of the identity service (the same database) and issues the JWT access token every other Edx host validates (the Jwt section is the same everywhere).
        It is built on Edx.Shared.Hosting and not on the microservices' shell: it does not reach Kafka, which is the microservices' alone.
    -->

    <ItemGroup>
        <!-- the private key that signs the tokens (made with samples/scripts/generate-rsa-keys.cs, a secret, not in git) -->
        <Content Include="private_key.xml" Condition="Exists('private_key.xml')" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- the cache the host chose, and the claims of the tenant a token carries -->
        <ProjectReference Include="..\..\..\..\src\HsnSoft.Base.Caching.StackExchangeRedis\HsnSoft.Base.Caching.StackExchangeRedis.csproj" />
        <ProjectReference Include="..\..\..\..\src\HsnSoft.Base.MultiTenancy.Authentication\HsnSoft.Base.MultiTenancy.Authentication.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\shared\Edx.Shared.Helper\Edx.Shared.Helper.csproj" />
        <ProjectReference Include="..\..\shared\Edx.Shared.Hosting\Edx.Shared.Hosting.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- the users, the roles and the tenants: the identity service's, the same database (read only) -->
        <ProjectReference Include="..\..\service\identity\Edx.IdentityService.EntityFrameworkCore\Edx.IdentityService.EntityFrameworkCore.csproj" />
    </ItemGroup>

</Project>
