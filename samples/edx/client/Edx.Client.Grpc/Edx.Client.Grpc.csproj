<Project Sdk="Microsoft.NET.Sdk">

    <!-- The example of a customer's program that sends an invoice file to Edx over gRPC (see ../README.md). The contract is the proto file the Edx team gives: Protos/intake.proto. -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <Protobuf Include="Protos\intake.proto" GrpcServices="Client" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Google.Protobuf" />
        <PackageReference Include="Grpc.Net.Client" />
        <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    </ItemGroup>

</Project>
